# Copy to .env locally. For production, set on Cloudflare Pages
# (Project → Settings → Environment variables — Production + Preview).

# Customer.io newsletter / lead capture
# Browser → POST /api/forms → Track Forms API (credentials stay server-side).
#
# Shared WSS Customer.io workspace is EU — region must be eu.
# CUSTOMER_IO_SITE_ID=xxxx
# CUSTOMER_IO_TRACK_API_KEY=xxxx
# CUSTOMER_IO_REGION=eu
# CUSTOMER_IO_FORM_ID=dj-newsletter
# PUBLIC_CUSTOMER_IO_FORM_ID=dj-newsletter

# Enquiries — /contact message form + /fractional-cmo intake. Separate form id
# so enquiries don't land in the newsletter connection and can trigger their own
# notification campaign in Customer.io.
# PUBLIC_CUSTOMER_IO_CONTACT_FORM_ID=dj-contact
