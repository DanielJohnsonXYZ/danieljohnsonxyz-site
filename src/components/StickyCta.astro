---
import { ctas } from "../site";
import WhatsAppCta from "./WhatsAppCta.astro";

interface Props {
  /** If true, renders the sticky bar at all. Set false on pages that already
   *  end in a full-width booking block (e.g. /fractional-cmo after the Calendly embed). */
  enabled?: boolean;
  /** The pixel threshold (scrollY) after which the bar appears. */
  revealAfter?: number;
  /** Contextual override, e.g. "Enquire about speaking" on /speaking. */
  label?: string;
  href?: string;
  hint?: string;
}

const {
  enabled = true,
  revealAfter = 1400,
  label = `${ctas.growthNote.label} →`,
  href = ctas.growthNote.href,
  hint = "Two ways to keep in touch"
} = Astro.props;

// The bar always ends in an equal-weight pair: newsletter | WhatsApp group.
// Some pages override the CTA with something else (a speaking enquiry, a
// download); that override rides above the pair on its own row. When the page
// CTA *is* the newsletter — the default — the pair carries it, so we never
// show two links to the same destination.
const showPageCta = href !== ctas.growthNote.href;
---

{enabled && (
  <div
    class="sticky-cta"
    data-reveal-after={revealAfter}
    role="complementary"
    inert
  >
    <div class="sticky-cta-inner">
      <div class="sticky-cta-copy">
        <span class="sticky-cta-hint">{hint}</span>
      </div>
      <button
        class="sticky-cta-dismiss"
        type="button"
        aria-label="Dismiss newsletter banner"
      >
        ×
      </button>
      <div class="sticky-cta-actions">
        {showPageCta && (
          <a
            class="sticky-cta-lead"
            href={href}
            data-cta="sticky-page-cta"
          >
            {label}
          </a>
        )}
        <div class="sticky-cta-duo">
          <a
            class="cta-card sticky-cta-card"
            href={ctas.growthNote.href}
            data-cta="sticky-newsletter"
          >
            <span class="cta-card-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
            </span>
            <span class="cta-card-copy">
              <span class="cta-card-title">{ctas.growthNote.label}</span>
              <span class="cta-card-sub">{ctas.growthNote.hint}</span>
            </span>
            <span class="cta-card-arrow" aria-hidden="true">→</span>
          </a>
          <WhatsAppCta
            variant="card"
            buttonClass="sticky-cta-card"
            label="Join the WhatsApp group"
            sublabel="Founders trading GTM notes in real time."
            dataCta="sticky-whatsapp"
          />
        </div>
      </div>
    </div>
  </div>
)}

<style is:global>
  @import "../styles/mobile-qa.css";

  .sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: max(1.25rem, env(safe-area-inset-bottom, 0px));
    z-index: 45;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
    opacity: 0;
    transform: translateY(120%);
    transition: opacity 280ms ease, transform 320ms cubic-bezier(.2,.9,.3,1);
  }

  .sticky-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .sticky-cta.is-dismissed {
    display: none;
  }

  /* The newsletter popup pitches the same signup — the bar stands down while
     the dialog is up rather than sitting dimmed behind its backdrop. */
  :root[data-newsletter-popup-open] .sticky-cta {
    opacity: 0;
    pointer-events: none;
  }

  /* Two rows: the hint (with the dismiss control) above a matched pair of
     CTA cards, so both the newsletter and the WhatsApp group read as real,
     clickable offers rather than mystery icons. */
  .sticky-cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "copy dismiss"
      "actions actions";
    align-items: center;
    gap: 0.5rem 0.65rem;
    width: min(660px, 100%);
    padding: 0.7rem 0.7rem 0.75rem;
    border: 1px solid color-mix(in srgb, #fff 10%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--ink) 96%, transparent);
    color: #fff;
    box-shadow:
      0 20px 45px -20px rgba(0, 0, 0, 0.75),
      0 2px 8px -2px rgba(0, 0, 0, 0.45);
    backdrop-filter: saturate(140%) blur(8px);
  }

  .sticky-cta-copy {
    grid-area: copy;
    display: flex;
    align-items: center;
    line-height: 1.35;
    min-width: 0;
    padding-inline-start: 0.35rem;
  }

  .sticky-cta-hint {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, #fff 55%, transparent);
  }

  .sticky-cta-actions {
    grid-area: actions;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* The newsletter and the group get identical space and identical weight —
     neither is the junior partner. */
  .sticky-cta-duo {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
  }

  .sticky-cta-duo > * {
    flex: 1 1 0;
    min-width: 0;
  }

  /* Identical treatment for both halves — same size, same surface, same
     weight. Each is a small card: icon badge, title, one line of detail,
     and an arrow that leans in on hover. */
  .sticky-cta-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid color-mix(in srgb, #fff 14%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, #fff 7%, transparent);
    color: #fff;
    text-align: left;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .sticky-cta-card:hover,
  .sticky-cta-card:focus-visible {
    background: color-mix(in srgb, #fff 13%, transparent);
    border-color: color-mix(in srgb, #fff 30%, transparent);
    transform: translateY(-1px);
    outline: none;
  }

  .cta-card-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
  }

  .cta-card-badge svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .cta-card-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .cta-card-title {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.005em;
  }

  .cta-card-sub {
    font-size: 0.72rem;
    line-height: 1.35;
    color: color-mix(in srgb, #fff 62%, transparent);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .cta-card-arrow {
    margin-left: auto;
    padding-left: 0.35rem;
    font-size: 0.85rem;
    color: color-mix(in srgb, #fff 55%, transparent);
    transition: transform 160ms ease, color 160ms ease;
  }

  .sticky-cta-card:hover .cta-card-arrow,
  .sticky-cta-card:focus-visible .cta-card-arrow {
    transform: translateX(2px);
    color: #fff;
  }

  /* Page-specific CTA (speaking enquiry, media kit) rides above the pair,
     in the brand accent so it still leads where a page has one. */
  .sticky-cta-lead {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 0.75rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    transition: background 160ms ease, border-color 160ms ease;
  }

  .sticky-cta-lead:hover,
  .sticky-cta-lead:focus-visible {
    background: color-mix(in srgb, var(--accent) 85%, white);
    border-color: color-mix(in srgb, var(--accent) 85%, white);
    outline: none;
  }

  .sticky-cta-dismiss {
    grid-area: dismiss;
    flex-shrink: 0;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #fff 18%, transparent);
    background: transparent;
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .sticky-cta-dismiss:hover,
  .sticky-cta-dismiss:focus-visible {
    background: color-mix(in srgb, #fff 14%, transparent);
    outline: none;
  }

  @media (max-width: 520px) {
    .sticky-cta {
      bottom: 0.75rem;
    }
    .sticky-cta-inner {
      gap: 0.5rem;
      padding: 0.7rem;
      border-radius: 1.25rem;
    }
    .sticky-cta-hint {
      font-size: 0.74rem;
      line-height: 1.4;
    }
    /* Stacked below 520px — still equal-sized, just full-width cards
       rather than two cramped columns. */
    .sticky-cta-duo {
      flex-direction: column;
    }
    .sticky-cta-card {
      padding: 0.65rem 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.querySelector('.sticky-cta');
    if (!bar) return;

    var revealAfter = Number(bar.getAttribute('data-reveal-after') || 1400);
    var dismissKey = 'dj-sticky-cta-dismissed';
    var dismissed = false;
    var overlapSelector = 'footer, .site-footer-v2, form, .growth-diagnosis, .cta-gradient, .evergreen-updated, #proof, [aria-label="Ways to work together"], .v5-ladder, .v5-final-cta, .v5-section-proof';
    var overlapsSensitiveArea = false;

    try {
      dismissed = sessionStorage.getItem(dismissKey) === '1';
    } catch (err) {
      // sessionStorage may be blocked (Safari private). Fall back to in-memory.
    }

    if (dismissed) {
      bar.classList.add('is-dismissed');
      return;
    }

    function update() {
      if (dismissed) return;
      var shouldShow = window.scrollY > revealAfter && !overlapsSensitiveArea;
      bar.classList.toggle('is-visible', shouldShow);
      bar.toggleAttribute('inert', !shouldShow);
      // Reserve space at the bottom of the page while the bar is shown so it
      // never sits on top of body text or cards.
      document.body.style.paddingBottom = shouldShow ? '5.5rem' : '';
    }

    var dismissBtn = bar.querySelector('.sticky-cta-dismiss');
    if (dismissBtn) {
      dismissBtn.addEventListener('click', function () {
        dismissed = true;
        bar.classList.remove('is-visible');
        bar.setAttribute('inert', '');
        bar.classList.add('is-dismissed');
        try {
          sessionStorage.setItem(dismissKey, '1');
        } catch (err) {
          // ignore
        }
      });
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        overlapsSensitiveArea = entries.some(function (entry) {
          return entry.isIntersecting;
        });
        update();
      }, {
        rootMargin: '40px 0px 40px 0px',
        threshold: [0, 0.05, 0.1]
      });

      document.querySelectorAll(overlapSelector).forEach(function (el) {
        observer.observe(el);
      });
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    // Run once on load so it's correct after a deep-link / back-nav.
    update();
  })();
</script>
