---
// NewsletterFormInline.astro — Growth Notes capture via Customer.io (/api/forms).
//
// Form id: src/site.ts → customerIoNewsletter (PUBLIC_CUSTOMER_IO_FORM_ID).
//
// Variants: `variant` = "strip" (compact) or "card" (full block).

import { customerIoNewsletter } from "../site";

interface Props {
  variant?: "strip" | "card";
  /** Use on dark backgrounds (e.g. site footer). */
  tone?: "light" | "dark";
  heading?: string;
  subline?: string;
  /** Set on pages with a hero link to #anchor (e.g. /newsletter). Omit when multiple forms on one page. */
  anchorId?: string;
  headingLevel?: 2 | 3;
  idPrefix?: string;
  /** Submit label. Default keeps the short form used in the footer/strips. */
  buttonLabel?: string;
}

const {
  variant = "strip",
  tone = "light",
  heading = "Practical notes on founder-led growth, AI GTM, positioning, and pipeline systems.",
  subline = "Occasional, with no daily drip, and unsubscribe in one click.",
  anchorId,
  headingLevel = 3,
  idPrefix,
  buttonLabel = "Subscribe →"
} = Astro.props;

const { submitUrl, formId } = customerIoNewsletter;
const formIdSuffix = idPrefix ?? `nl-${variant}-${tone}`;
const headingId = `${formIdSuffix}-title`;
const emailId = `${formIdSuffix}-email`;
const HeadingTag = headingLevel === 2 ? "h2" : "h3";
---

<section
  {...(anchorId ? { id: anchorId } : {})}
  class:list={["nl-form", `nl-form-${variant}`, tone === "dark" && "nl-form--dark"]}
  aria-labelledby={headingId}
>
  <div class="nl-inner">
    <div class="nl-copy">
      <p class="nl-eyebrow">Growth Notes</p>
      <HeadingTag id={headingId}>{heading}</HeadingTag>
      {subline && <p class="nl-sub">{subline}</p>}
    </div>
    <form
      class="nl-fields"
      action={submitUrl}
      method="post"
      accept-charset="UTF-8"
      data-cta="newsletter-inline-submit"
      data-cio-source-form
    >
      <input type="hidden" name="form_id" value={formId} />
      <input type="hidden" name="source_type" value="newsletter" />
      <input type="hidden" name="source_page" value="" data-source-page />
      <label class="nl-label" for={emailId}>
        <span class="sr-only">Email address</span>
        <input
          id={emailId}
          class="nl-input"
          type="email"
          name="email"
          required
          placeholder="you@company.com"
          autocomplete="email"
          inputmode="email"
        />
      </label>
      <button class="nl-submit button-accent" type="submit">
        {buttonLabel}
      </button>
    </form>
    <p class="nl-status" data-signup-status hidden></p>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("form[data-cio-source-form]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.cioBound) return;
    form.dataset.cioBound = "1";

    const pageField = form.querySelector("[data-source-page]");
    if (pageField instanceof HTMLInputElement) {
      pageField.value = window.location.href;
    }

    const status = form.parentElement?.querySelector("[data-signup-status]");
    const button = form.querySelector('button[type="submit"]');

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = (data.get("email") || "").toString().trim();
      if (!email) return;

      if (button instanceof HTMLButtonElement) button.disabled = true;
      if (status instanceof HTMLElement) {
        status.hidden = false;
        status.textContent = "Subscribing…";
      }

      try {
        const res = await fetch(form.action || "/api/forms", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            email,
            form_id: (data.get("form_id") || "").toString(),
            source_type: (data.get("source_type") || "newsletter").toString(),
            source_page: (data.get("source_page") || window.location.href).toString()
          })
        });
        const payload = await res.json().catch(() => ({}));
        if (res.ok && payload.ok) {
          form.reset();
          if (pageField instanceof HTMLInputElement) pageField.value = window.location.href;
          if (status instanceof HTMLElement) status.textContent = "You're in. Check your inbox.";
          // Lets the newsletter popup retire itself for anyone who has signed up.
          document.dispatchEvent(new CustomEvent("newsletter:subscribed"));
        } else if (status instanceof HTMLElement) {
          status.textContent = "Something went wrong — try again in a moment.";
        }
      } catch (_) {
        if (status instanceof HTMLElement) {
          status.textContent = "Something went wrong — try again in a moment.";
        }
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  });
</script>

<style>
  .nl-form {
    background: var(--surface-dim);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    padding: 1.5rem 1.5rem;
  }
  @media (min-width: 768px) {
    .nl-form { padding: 1.5rem 1.75rem; }
  }

  .nl-inner {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .nl-form-strip .nl-inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 1.5rem;
    }
  }

  .nl-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .nl-form h3 {
    font-size: 1.1rem;
    line-height: 1.45;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    max-width: 42rem;
  }
  @media (min-width: 768px) {
    .nl-form-card h3 { font-size: 1.35rem; }
  }

  .nl-sub {
    margin-top: 0.4rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .nl-fields {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
  }
  /* Strip: stack on mobile for tap targets; row only from md */
  @media (min-width: 768px) {
    .nl-form-strip .nl-fields {
      flex-direction: row;
      align-items: stretch;
      gap: 0.5rem;
    }
  }

  .nl-label {
    flex: 1;
    min-width: 0;
    width: 100%;
  }
  @media (min-width: 768px) {
    .nl-form-strip .nl-label { width: auto; }
  }
  .nl-input {
    width: 100%;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
    color: var(--ink);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .nl-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .nl-submit {
    flex-shrink: 0;
    white-space: nowrap;
    width: 100%;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .nl-form-strip .nl-submit {
      width: auto;
      justify-content: center;
    }
  }

  .nl-status {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* Dark footer / band */
  .nl-form--dark {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .nl-form--dark .nl-eyebrow {
    color: color-mix(in srgb, var(--accent) 85%, white);
  }
  .nl-form--dark h3,
  .nl-form--dark .nl-sub {
    color: rgba(255, 255, 255, 0.92);
  }
  .nl-form--dark .nl-sub {
    color: rgba(255, 255, 255, 0.6);
  }
  .nl-form--dark .nl-input {
    background: rgba(0, 0, 0, 0.25);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
  }
  .nl-form--dark .nl-input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }
  .nl-form--dark .nl-status {
    color: rgba(255, 255, 255, 0.7);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
</style>
