---
import { customerIoNewsletter } from "../site";

interface Props {
  /** Customer.io form id (Integrations → Forms). */
  formId: string;
  heading: string;
  subline: string;
  buttonLabel: string;
  idPrefix: string;
  leadMagnet?: string;
}

const {
  formId,
  heading,
  subline,
  buttonLabel,
  idPrefix,
  leadMagnet = ""
} = Astro.props;
const emailId = `${idPrefix}-email`;
const submitUrl = customerIoNewsletter.submitUrl;
---

<section class="lead-form" aria-labelledby={`${idPrefix}-title`}>
  <div>
    <p class="lead-form-kicker">Free workbook + guide</p>
    <h2 id={`${idPrefix}-title`}>{heading}</h2>
    <p>{subline}</p>
  </div>
  <form
    id={idPrefix}
    class="lead-form-fields"
    action={submitUrl}
    method="post"
    accept-charset="UTF-8"
    data-cta={`${idPrefix}-submit`}
    data-cio-lead-form
  >
    <input type="hidden" name="form_id" value={formId} />
    <input type="hidden" name="source_type" value="lead_magnet" />
    <input type="hidden" name="source_page" value="" data-source-page />
    <input type="hidden" name="lead_magnet" value={leadMagnet || formId} />
    <label for={emailId} class="sr-only">Work email address</label>
    <input
      id={emailId}
      type="email"
      name="email"
      placeholder="you@company.com"
      autocomplete="email"
      inputmode="email"
      required
    />
    <button class="button-accent" type="submit">{buttonLabel}</button>
  </form>
  <p class="lead-form-fine" data-signup-status>Includes a five-email implementation series over 16 days. Unsubscribe any time.</p>
</section>

<script is:inline>
  document.querySelectorAll("form[data-cio-lead-form]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.cioBound) return;
    form.dataset.cioBound = "1";

    const pageField = form.querySelector("[data-source-page]");
    if (pageField instanceof HTMLInputElement) {
      pageField.value = window.location.href;
    }

    const status = form.parentElement?.querySelector("[data-signup-status]");
    const button = form.querySelector('button[type="submit"]');
    const defaultFine = status?.textContent || "";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = (data.get("email") || "").toString().trim();
      if (!email) return;

      if (button instanceof HTMLButtonElement) button.disabled = true;
      if (status) status.textContent = "Subscribing…";

      try {
        const res = await fetch(form.action || "/api/forms", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            email,
            form_id: (data.get("form_id") || "").toString(),
            source_type: (data.get("source_type") || "lead_magnet").toString(),
            source_page: (data.get("source_page") || window.location.href).toString(),
            lead_magnet: (data.get("lead_magnet") || "").toString()
          })
        });
        const payload = await res.json().catch(() => ({}));
        if (res.ok && payload.ok) {
          form.reset();
          if (pageField instanceof HTMLInputElement) pageField.value = window.location.href;
          if (status) status.textContent = "You're in. Check your inbox.";
        } else if (status) {
          status.textContent = "Something went wrong — try again in a moment.";
        }
      } catch (_) {
        if (status) status.textContent = "Something went wrong — try again in a moment.";
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
        if (status && status.textContent === "Subscribing…") {
          status.textContent = defaultFine;
        }
      }
    });
  });
</script>

<style>
  .lead-form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line));
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }
  .lead-form-kicker {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .lead-form h2 {
    margin: 0;
    max-width: 48rem;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .lead-form > div > p:last-child,
  .lead-form-fine {
    color: var(--muted);
  }
  .lead-form > div > p:last-child { margin: 0.75rem 0 0; max-width: 47rem; line-height: 1.7; }
  .lead-form-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    max-width: 46rem;
  }
  .lead-form-fields input[type="email"] {
    flex: 1 1 250px;
    min-width: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font-size: 1rem;
  }
  .lead-form-fields input[type="email"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .lead-form-fine { margin: 0; font-size: 0.78rem; }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
  @media (max-width: 560px) {
    .lead-form-fields,
    .lead-form-fields input,
    .lead-form-fields button { width: 100%; }
  }
</style>
