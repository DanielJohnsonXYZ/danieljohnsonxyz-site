---
// WhatsAppCta.astro — outbound link to the founder WhatsApp community group.
// No backend, no form — just a styled link that always opens in a new tab.
// Reused in: homepage intro section, StickyCta, SiteFooter.
//
// Destination and default label live in src/site.ts (siteConfig), so the group
// link is only ever written down once.
import { siteConfig } from "../site";

interface Props {
  /** "button" renders a full label + icon button (pick buttonClass to match placement).
   *  "icon" renders a compact icon-only circular control.
   *  "card" renders an icon badge, title, sub-line and arrow — the shared
   *  .cta-card-* shape the sticky bar styles for both of its halves. */
  variant?: "button" | "icon" | "card";
  /** Existing button class to apply for the "button" variant — e.g. button-accent, button-secondary. */
  buttonClass?: string;
  label?: string;
  /** Second line, "card" variant only. */
  sublabel?: string;
  dataCta?: string;
}

const {
  variant = "button",
  buttonClass = "button-secondary",
  label = siteConfig.whatsappCommunityLabel,
  sublabel,
  dataCta = "whatsapp-community"
} = Astro.props;

const WHATSAPP_URL = siteConfig.whatsappCommunityUrl;
---

{
  variant === "card" ? (
    <a
      class:list={["cta-card", buttonClass]}
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-cta={dataCta}
    >
      <span class="cta-card-badge">
        <svg viewBox="0 0 448 512" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
          />
        </svg>
      </span>
      <span class="cta-card-copy">
        <span class="cta-card-title">{label}</span>
        {sublabel && <span class="cta-card-sub">{sublabel}</span>}
      </span>
      <span class="cta-card-arrow" aria-hidden="true">→</span>
    </a>
  ) : variant === "icon" ? (
    <a
      class="whatsapp-cta-icon"
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-cta={dataCta}
      aria-label={label}
    >
      <svg viewBox="0 0 448 512" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        />
      </svg>
    </a>
  ) : (
    <a
      class:list={["whatsapp-cta-btn", buttonClass]}
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-cta={dataCta}
    >
      <svg viewBox="0 0 448 512" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        />
      </svg>
      {label}
    </a>
  )
}

<style>
  /* Icon-only control — sized and styled to match .sticky-cta-dismiss so it
     drops cleanly into the dark sticky bar without extra tuning. */
  .whatsapp-cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #fff 18%, transparent);
    background: transparent;
    color: #fff;
    transition: background 150ms ease;
  }
  .whatsapp-cta-icon:hover,
  .whatsapp-cta-icon:focus-visible {
    background: color-mix(in srgb, #fff 14%, transparent);
    outline: none;
  }
  .whatsapp-cta-icon svg {
    width: 1rem;
    height: 1rem;
  }

  /* Button variant — icon + label, inherits sizing/colour from whichever
     .button-* class is passed in via buttonClass. */
  .whatsapp-cta-btn {
    gap: 0.55rem;
    text-decoration: none;
  }
  .whatsapp-cta-btn svg {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }
</style>
