---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandBar from "../components/BrandBar.astro";
import heroCutout from "../assets/images/daniel-hero-cutout.webp";
import danielAircraft from "../assets/images/daniel-aircraft.webp";
import "../styles/home-v6.css";
import { buildAggregateRatingSchema, buildFaqPageSchema, buildServiceSchema } from "../lib/schema";
import { absoluteUrl } from "../lib/utils";
import { icpFirmographics, proofStats, siteConfig } from "../site";

const homepageFaq = [
  {
    question: "What stage should my startup be at?",
    answer: "Post-PMF with real customers and repeat revenue, usually Seed to Series B. The best fit is roughly £1M–£20M ARR, a small team, and a founder who is still making too many weekly growth decisions.",
    link: { href: "/fractional-cmo/", label: "See the full fit criteria" },
    open: true
  },
  {
    question: "How is this different from an agency or a full-time CMO?",
    answer: "An agency usually owns a channel. A full-time CMO owns the whole function but comes with a full-time cost and hiring cycle. I sit in the middle: senior ownership across positioning, pipeline, reporting, team and agencies, for one or two days a week while the system is being built.",
    link: { href: "/resources/compare-growth-options/", label: "Compare the options" }
  },
  {
    question: "Do you execute, or only advise?",
    answer: "I do the senior operator work required to get the system running: analysis, positioning, priorities, dashboards, experiment design, briefs, hiring and agency decisions, and the first critical artefacts. I am not a junior execution team and I do not sell a pile of campaign hours."
  },
  {
    question: "What does it cost?",
    answer: "The 20-minute Growth Audit is free. Strategy Sprints start at £6k. Fractional CMO engagements typically start at £5k per month, usually for a three-month minimum, depending on days per week and how much operating support is needed.",
    link: { href: "/resources/fractional-cmo-cost-uk/", label: "See UK pricing benchmarks" }
  }
];

const homeSchemas = [
  buildServiceSchema({
    name: "Fractional CMO for Seed to Series B AI & B2B SaaS",
    description:
      "Embedded senior growth leadership for post-PMF AI and B2B SaaS startups. Build a growth system the team can run without the founder becoming the bottleneck.",
    url: absoluteUrl("/fractional-cmo/"),
    serviceType: "Fractional CMO",
    offers: [
      {
        name: "20-min Growth Audit",
        description: "Free 20-minute diagnostic call. Bottleneck read, fit decision, recommendation.",
        price: "0",
        billingIncrement: "per call"
      },
      {
        name: "Strategy Sprint",
        description: "2–4 weeks. Diagnose the bottleneck, set 90-day priorities, ship first artefacts.",
        price: "6000",
        billingIncrement: "per engagement"
      },
      {
        name: "Fractional CMO",
        description: "Embedded senior growth ownership, usually one to two days a week.",
        price: "5000",
        billingIncrement: "per month"
      }
    ]
  }),
  buildAggregateRatingSchema(),
  buildFaqPageSchema(homepageFaq)
];

const problemCards = [
  {
    title: "Leads are inconsistent",
    copy: "Some weeks are good. Some are dead. Too much of the pipeline still depends on referrals, founder outreach or one channel behaving itself."
  },
  {
    title: "People don't get what you do",
    copy: "The product makes sense when you explain it on a call. Your website, ads or outbound are not doing the same job."
  },
  {
    title: "You've tried loads of marketing",
    copy: "Paid, content, outbound, partnerships. Some things worked for a bit. Nobody is completely sure what deserves more money or attention."
  },
  {
    title: "Growth still depends on you",
    copy: "The team can do the work, but the important decisions and context still come back to the founder."
  }
];

const methodSteps = [
  {
    title: "Find the constraint",
    copy: "Customer calls, pipeline, funnel economics and current bets. We identify the one problem limiting growth now, not a list of twenty possible improvements."
  },
  {
    title: "Make the call",
    copy: "Choose the ICP, positioning, channel and priorities. Cut work that is not helping and make the trade-offs explicit."
  },
  {
    title: "Install the rhythm",
    copy: "Weekly decisions, one dashboard, clear experiments, ownership and handoffs. The growth function becomes visible instead of living in Slack threads and founder memory."
  },
  {
    title: "Transfer ownership",
    copy: "Coach the team, document the logic, make the right hire or agency calls, and hand over a system that keeps running after I leave."
  }
];

const proofCases = [
  {
    sector: "HealthTech · AI",
    metric: "6×",
    title: "Monthly app downloads",
    copy: "2k → 12k+ monthly downloads in six months after rebuilding acquisition and lifecycle around the real customer journey."
  },
  {
    sector: "Fintech · Crypto",
    metric: "35%",
    title: "Lower CAC in eight weeks",
    copy: "Segmentation, paid account structure and landing-page routing cut acquisition cost while keeping the team focused on the same ICP."
  },
  {
    sector: "eCommerce",
    metric: "21%",
    title: "Less churn in three months",
    copy: "Lifecycle and win-back messaging improved retention without relying on another acquisition channel to hide the leak."
  }
];

const goodFit = [
  `${icpFirmographics.arrBand} B2B SaaS or AI with repeat revenue`,
  "Seed to Series B, post-PMF, with real customers and a real sales motion",
  "Founder still owns too many weekly growth decisions",
  "You need senior judgement across the whole system, not another channel specialist"
];

const notFit = [
  "Pre-revenue or still searching for product-market fit",
  "You mainly need hands to run ads, post content or build landing pages",
  "You want more reporting without changing how decisions get made",
  "There is no appetite to stop low-value work or change ownership"
];

const workOptions = [
  {
    label: "Start here",
    title: "20-min Growth Audit",
    price: "Free · 20 minutes",
    copy: "Bring the messy growth question. We name the bottleneck and decide whether working together makes sense. No deck and no pitch.",
    outcome: "A clearer read on the problem and the most useful next step.",
    href: "/growth-audit/",
    cta: "See what the audit covers"
  },
  {
    label: "Short project",
    title: "Strategy Sprint",
    price: "From £6k · 2–4 weeks",
    copy: "Diagnose, prioritise and ship the first critical artefacts: ICP, positioning, 90-day priorities, dashboard and first live test.",
    outcome: "A focused 90-day plan and a working growth rhythm.",
    href: "/strategy-sprint/",
    cta: "See the Sprint scope"
  },
  {
    label: "Core engagement",
    title: "Fractional CMO",
    price: "From £5k/mo · 1–2 days a week",
    copy: "Embedded senior ownership across positioning, pipeline, reporting, team and agencies. I build the function with you, then hand it over cleanly.",
    outcome: "A growth system your team can run without you becoming the bottleneck.",
    href: "/fractional-cmo/",
    cta: "Explore Fractional CMO",
    featured: true
  }
];

const credentials = [
  { title: "Founder + operator", text: "Founder-side exit experience, then in-house startup growth roles." },
  { title: "Mentor", text: `${proofStats.mentorSessions} GrowthMentor sessions · ${proofStats.mentorRating}/5.` },
  { title: "Teacher", text: "Cambridge Judge, Imperial College London and Google startup workshops." },
  { title: "Scale", text: `${proofStats.startupsAdvised} startups advised · ${proofStats.revenueImpact} client revenue impact.` }
];
---

<BaseLayout
  title="Fractional CMO for AI & B2B SaaS Startups"
  description="Fractional CMO for Seed–Series B AI & B2B SaaS startups. Build a growth system your team can run without founder-dependent growth."
  schema={homeSchemas}
  lastUpdated={false}
  stickyCta={true}
  footerCtaCompact={true}
  newsletterPopup={false}
>
  <main class="home-v6">
    <!-- Hero: answer who, what, why, and next step before anything else. -->
    <section class="h6-hero" aria-label="Introduction">
      <div class="h6-container">
        <div class="h6-hero-grid">
          <div class="h6-hero-copy">
            <span class="h6-eyebrow">Fractional CMO · AI &amp; B2B SaaS</span>
            <h1 class="h6-title">Make growth stop <em>depending on you.</em></h1>
            <p class="h6-hero-lead">
              You've got customers. Maybe leads come in bursts, people don't understand the product quickly enough, or every important growth decision still comes back to you. I help work out what's getting in the way, fix it, and get the team running it without you in everything.
            </p>
            <div class="h6-hero-actions">
              <a href="/contact/#book-growth-audit" class="h6-button h6-button-primary" data-cta="home-hero-talk">
                {siteConfig.navBookingLabel} <span aria-hidden="true">→</span>
              </a>
              <a href="#proof" class="h6-button h6-button-secondary" data-cta="home-hero-proof">See the proof</a>
            </div>
            <div class="h6-fitline" aria-label="Best fit">
              <span class="h6-fit-chip">Post-PMF</span>
              <span class="h6-fit-chip">Seed–Series B</span>
              <span class="h6-fit-chip">{icpFirmographics.arrBand}</span>
              <span class="h6-fit-chip">Founder-led growth</span>
            </div>
          </div>

          <div class="h6-hero-visual" aria-label="Daniel Johnson and selected proof points">
            <Image
              class="h6-hero-portrait"
              src={heroCutout}
              widths={[440, 660, 880]}
              sizes="(max-width: 860px) 82vw, 32rem"
              alt="Daniel Johnson, fractional CMO and startup growth operator"
              loading="eager"
              fetchpriority="high"
            />
            <div class="h6-proof-float h6-proof-float-a">
              <strong>{proofStats.revenueImpact}</strong>
              <span>client revenue impact</span>
            </div>
            <div class="h6-proof-float h6-proof-float-b">
              <strong>{proofStats.mentorRating} / 5</strong>
              <span>{proofStats.mentorReviewCount} GrowthMentor reviews</span>
            </div>
            <div class="h6-proof-note">{proofStats.startupsAdvised} startups advised · {proofStats.mentorSessions} mentor sessions</div>
          </div>
        </div>

        <div class="h6-trust reveal">
          <BrandBar label="Taught, mentored and worked with teams at" />
        </div>
      </div>
    </section>

    <!-- Problem: qualify the pain before explaining the method. -->
    <section class="h6-section h6-problem" aria-label="When Daniel is useful">
      <div class="h6-container reveal">
        <div class="h6-head">
          <div>
            <span class="h6-eyebrow">When I’m useful</span>
            <h2 class="h6-h2">This is usually where I come in.</h2>
          </div>
          <p class="h6-kicker">
            The company is moving, but growth still feels harder and less predictable than it should.
          </p>
        </div>

        <div class="h6-problem-grid">
          {problemCards.map((item, index) => (
            <article class="h6-problem-card">
              <span class="h6-card-n">0{index + 1}</span>
              <h3 class="h6-h3">{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>

        <div class="h6-problem-point">
          <span class="h6-point-mark" aria-hidden="true">✓</span>
          <p><strong>I normally find one or two things that matter much more than everything else.</strong> We fix those first. If I don't think you need me, I'll tell you.</p>
        </div>
      </div>
    </section>
    <!-- Proof: outcomes before service packaging. -->
    <section id="proof" class="h6-section h6-proof" aria-label="Proof and case studies">
      <div class="h6-container reveal">
        <div class="h6-head">
          <div>
            <span class="h6-eyebrow">Proof</span>
            <h2 class="h6-h2">I've dealt with this before.</h2>
          </div>
          <p class="h6-kicker">
            A few results from the work, plus the wider numbers behind them.
          </p>
        </div>

        <div class="h6-proof-grid">
          {proofCases.map((item) => (
            <article class="h6-case">
              <div class="h6-case-topline"><span>{item.sector}</span><span>Case result</span></div>
              <div class="h6-case-metric">{item.metric}</div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>

        <div class="h6-proof-quote">
          <blockquote>“Named the two levers that mattered. Inside 60 days we had a weekly rhythm and pipeline built to our ICP.”</blockquote>
          <cite>Christian A.<br />Founder, AI HealthTech</cite>
        </div>

        <div class="h6-proof-actions">
          <a href="/case-studies/" class="h6-button h6-button-primary" data-cta="home-proof-cases">Read the case studies</a>
          <a href="/testimonials/" class="h6-text-link" data-cta="home-proof-testimonials">See client and mentor reviews</a>
        </div>
      </div>
    </section>


    <!-- Method: simple sequence, not a complicated framework diagram. -->
    <section class="h6-section h6-method" aria-label="How Daniel works">
      <div class="h6-container reveal">
        <div class="h6-head">
          <div>
            <span class="h6-eyebrow">How I work</span>
            <h2 class="h6-h2">Work out what's wrong. Fix it. Make it easier to run.</h2>
          </div>
          <p class="h6-kicker">
            The details change by company. I start by finding the thing holding growth back, decide what to do about it, and make sure the team can keep going.
          </p>
        </div>

        <div class="h6-method-steps">
          {methodSteps.map((item, index) => (
            <article class="h6-method-step">
              <span class="h6-card-n">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>

        <div class="h6-method-footer">
          <p>I should become less useful over time. The team should be able to run this without me.</p>
          <a href="/method/" class="h6-text-link" data-cta="home-method">See the full method</a>
        </div>
      </div>
    </section>

    <!-- Fit: let the wrong buyer leave before pricing. -->
    <section class="h6-section h6-fit" aria-label="Fit check">
      <div class="h6-container reveal">
        <div class="h6-fit-shell">
          <div class="h6-fit-copy">
            <span class="h6-eyebrow">Fit</span>
            <h2 class="h6-h2">This works best when the product already works.</h2>
            <p class="h6-kicker">
              If the product is still the question, stay close to customers and product. If growth is the bottleneck, that is where I become useful.
            </p>
          </div>

          <div class="h6-fit-columns">
            <div class="h6-fit-card h6-fit-card-good">
              <h3>Probably a fit</h3>
              <ul>
                {goodFit.map((item) => (
                  <li><span class="h6-fit-icon">✓</span><span>{item}</span></li>
                ))}
              </ul>
            </div>
            <div class="h6-fit-card h6-fit-card-not">
              <h3>Probably not yet</h3>
              <ul>
                {notFit.map((item) => (
                  <li><span class="h6-fit-icon">×</span><span>{item}</span></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Commercial options: only the three paths that matter for this buyer. -->
    <section class="h6-section h6-work" aria-label="Ways to work together">
      <div class="h6-container reveal">
        <div class="h6-head">
          <div>
            <span class="h6-eyebrow">Ways to work together</span>
            <h2 class="h6-h2">Start with the smallest thing that helps.</h2>
          </div>
          <p class="h6-kicker">
            If you're not sure what's wrong, start with the free call. If the problem is clear, we can decide whether you need a short project or someone inside the business.
          </p>
        </div>

        <div class="h6-work-grid">
          {workOptions.map((item) => (
            <article class:list={["h6-work-card", item.featured && "h6-work-card-featured"]}>
              <span class="h6-work-label">{item.label}</span>
              <h3>{item.title}</h3>
              <div class="h6-work-price">{item.price}</div>
              <p>{item.copy}</p>
              <div class="h6-work-outcome">
                <small>Outcome</small>
                <strong>{item.outcome}</strong>
              </div>
              <a href={item.href} class="h6-text-link" data-cta={`home-work-${item.title.toLowerCase().replaceAll(" ", "-")}`}>{item.cta}</a>
            </article>
          ))}
        </div>

        <p class="h6-work-foot">
          Need a focused second opinion rather than an engagement? <a href="/founder-office-hours/">Founder Office Hours</a> is the lighter option.
        </p>
      </div>
    </section>

    <!-- About: enough humanity and credibility, without turning home into an autobiography. -->
    <section class="h6-section h6-about" aria-label="About Daniel">
      <div class="h6-container reveal">
        <div class="h6-about-grid">
          <div class="h6-about-image-wrap">
            <Image
              class="h6-about-image"
              src={danielAircraft}
              widths={[640, 960, 1280]}
              sizes="(max-width: 860px) 100vw, 42vw"
              alt="Daniel Johnson, startup founder and growth operator"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="h6-about-copy">
            <span class="h6-eyebrow">Why me</span>
            <h2 class="h6-h2">I have been on both sides of the growth problem.</h2>
            <p>
              I started as a founder, then ran growth in-house at startups, then built We Scale Startups around the same recurring problem: good products with growth trapped in the founder’s head.
            </p>
            <p>
              Today I work as the senior operator between founder, marketing, sales and agencies. The job is to make the commercial logic clear, build the rhythm around it, and leave the team stronger than I found it.
            </p>

            <div class="h6-credentials" aria-label="Selected experience">
              {credentials.map((item) => (
                <div class="h6-credential">
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                </div>
              ))}
            </div>

            <a href="/about/" class="h6-text-link" data-cta="home-about">Read the longer story</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ: only objections that materially affect the buying decision. -->
    <section class="h6-section h6-faq" aria-label="Frequently asked questions">
      <div class="h6-container reveal">
        <div class="h6-faq-shell">
          <div class="h6-faq-copy">
            <span class="h6-eyebrow">FAQ</span>
            <h2 class="h6-h2">The questions worth answering before a call.</h2>
            <p class="h6-kicker">Everything else is easier to answer once I understand the actual company.</p>
          </div>

          <div class="h6-faq-list">
            {homepageFaq.map((item) => (
              <details open={item.open}>
                <summary>{item.question}</summary>
                <p class="h6-faq-answer">
                  {item.answer}
                  {item.link && <> <a href={item.link.href}>{item.link.label}</a></>}
                </p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="h6-final" aria-label="Final call to action">
      <div class="h6-container reveal">
        <div class="h6-final-card">
          <span class="h6-eyebrow">Next step</span>
          <h2 class="h6-h2">Bring me the messy growth question.</h2>
          <p class="h6-kicker">
            Twenty minutes on your actual situation. No deck and no pitch. We will name the bottleneck, decide what I would do next, and work out whether I am the right person to help.
          </p>
          <div class="h6-final-actions">
            <a href="/contact/#book-growth-audit" class="h6-button h6-button-dark" data-cta="home-final-talk">{siteConfig.navBookingLabel} <span aria-hidden="true">→</span></a>
            <span class="h6-final-email">Prefer email? <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
