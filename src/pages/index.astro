---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandBar from "../components/BrandBar.astro";
import GrowthDiagnosis from "../components/GrowthDiagnosis.astro";
import NewsletterFormInline from "../components/NewsletterFormInline.astro";
import WhatsAppCta from "../components/WhatsAppCta.astro";
import heroCutout from "../assets/images/daniel-hero-cutout.webp";
import danielAircraft from "../assets/images/daniel-aircraft.webp";
import cambridgeJudge from "../assets/images/cambridge-judge-business-school-960.webp";
import "../styles/home-v5.css";
import { buildAggregateRatingSchema, buildFaqPageSchema, buildServiceSchema } from "../lib/schema";
import { absoluteUrl } from "../lib/utils";
import { icpFirmographics, siteConfig } from "../site";

// FAQ items drive both the FAQPage schema and the visible markup below, so the
// two can't drift. `answer` is the schema text; `link` renders only in the page.
const homepageFaq = [
  {
    question: "What does a fractional CMO actually do day-to-day?",
    answer: "Owns the weekly GTM rhythm. Sharp ICP and positioning, channel and experiment priorities, reporting that drives scale-stop-fix decisions, and the handoffs between founder, sales, and any agencies. It is operator work in your Slack and meetings rather than a monthly slide deck."
  },
  {
    question: "How is this different from hiring a full-time CMO?",
    answer: "You buy a slice of senior time with a clear scope, usually one to two days a week, instead of a £120–180k+ base, equity, and a six-month ramp before the system shows up. Most teams use fractional to install the operating system, then hire full-time into something that already runs.",
    link: { href: "/resources/fractional-cmo-vs-full-time-cmo/", label: "Fractional vs full-time" },
    open: true
  },
  {
    question: "What stage should my startup be at?",
    answer: "Post-PMF with real revenue and repeat buyers, typically Seed to Series B. At that stage the constraint is execution and ownership. Pre-revenue teams should stay focused on customers and product first.",
    link: { href: "/resources/fractional-cmo-vs-full-time-cmo/", label: "When each model fits" }
  },
  {
    question: "How quickly will I see results?",
    answer: "Sharper decisions and cleaner reporting within the first few weeks. Meaningful pipeline and conversion movement usually shows in 30–90 days depending on sales cycle length and how fast tests ship. No miracles promised, just a visible system and honest calls on what’s working."
  },
  {
    question: "What does it cost?",
    answer: "UK engagements typically start around £6k for a Strategy Sprint and £5–7.5k/month for fractional CMO (three-month minimum), scoped to days per week and depth. The service page lists how the week runs. The UK cost page lists benchmark ranges and what moves price.",
    link: { href: "/resources/fractional-cmo-cost-uk/", label: "Fractional CMO cost (UK)" }
  },
  {
    question: "How do I know if this will work for my business?",
    answer: "If growth still depends on you reading every dashboard and approving every message, and the team does not share one constraint map, the model fits. The 20-minute audit is deliberately designed to name the bottleneck and say no when the shape of help is wrong."
  }
];

const homeSchemas = [
  buildServiceSchema({
    name: "Fractional CMO for Seed to Series B AI & B2B SaaS",
    description:
      "Embedded senior GTM leadership for post-PMF AI and B2B SaaS startups. Predictable pipeline and sharper positioning without a £150k+ full-time hire. Typical UK engagement range: £5,000–£7,500/month.",
    url: absoluteUrl("/fractional-cmo/"),
    serviceType: "Fractional CMO",
    offers: [
      {
        name: "20-min Growth Audit",
        description: "Free 20-minute diagnostic call. Bottleneck read, fit decision, recommendation.",
        price: "0",
        billingIncrement: "per call"
      },
      {
        name: "Strategy Sprint",
        description: "2–4 weeks. Diagnose the bottleneck, set 90-day priorities, ship first artefacts.",
        price: "6000",
        billingIncrement: "per engagement"
      },
      {
        name: "Fractional CMO",
        description: "3-month minimum. Embedded senior ownership 1 day a week.",
        price: "5000",
        billingIncrement: "per month"
      },
      {
        name: "Fractional CMO Plus",
        description: "Deeper operating support, agency management, faster execution.",
        price: "7500",
        billingIncrement: "per month"
      }
    ]
  }),
  buildAggregateRatingSchema(),
  buildFaqPageSchema(homepageFaq)
];

// Engine — six layers, one loop. Node geometry for the SVG (center 260, r 190).
const engineNodes = [
  { href: "/gtm-systems/", n: "01", t: "Customer signal", d: "ICP, calls, signal", x: 260, y: 70 },
  { href: "/gtm-systems/", n: "02", t: "GTM systems", d: "Positioning, cadence, dashboards", x: 424.5, y: 165 },
  { href: "/experimentation/", n: "03", t: "Acquisition", d: "Channels, experiments, decision rules", x: 424.5, y: 355 },
  { href: "/product-led-growth/", n: "04", t: "Conversion", d: "Funnel, activation, demo-booking fixes", x: 260, y: 450 },
  { href: "/founder-led-distribution/", n: "05", t: "Founder-led distribution", d: "Voice, content, pipeline loop", x: 95.5, y: 355 },
  { href: "/revenue-operations/", n: "06", t: "Reporting", d: "Scale, stop, fix", x: 95.5, y: 165 }
];
---

<BaseLayout
  title="Fractional CMO for AI & B2B SaaS Startups"
  description="Fractional CMO for Seed–Series B AI & B2B SaaS startups. Predictable pipeline, sharper positioning and senior growth leadership without a £150k full-time hire."
  schema={homeSchemas}
  lastUpdated={false}
  stickyCta={true}
  footerCtaCompact={true}
>
  <div class="v5-home">
    <!-- ===== Hero ===== -->
    <section class="v5-hero" aria-label="Introduction">
      <!-- Atmosphere: layered light, fading rule grid, film grain. Purely decorative. -->
      <div class="v5-hero-atmos" aria-hidden="true">
        <div class="v5-hero-lines"></div>
        <div class="v5-hero-glow v5-hero-glow-warm"></div>
        <div class="v5-hero-glow v5-hero-glow-teal"></div>
        <div class="v5-hero-grain"></div>
        <div class="v5-hero-vignette"></div>
      </div>

      <div class="v5-hero-inner">
        <div class="v5-hero-copy">
          <p class="v5-hero-badge">
            <span class="v5-hero-dot" aria-hidden="true"></span>
            <strong>Daniel Johnson</strong>
            <span class="v5-hero-badge-sep" aria-hidden="true">·</span>
            <span>Fractional CMO · Seed–Series B</span>
          </p>
          <h1 class="v5-hero-title">
            I build the growth engine your startup is missing, then hand your team <em class="v5-hl">the keys.</em>
          </h1>
          <p class="v5-hero-lede">
            Embedded fractional CMO for post-PMF B2B SaaS and AI teams. I build the growth foundation under your traction, then scale it with you until your team can run it without me.
          </p>
          <div class="v5-hero-ctas">
            <a href="/contact/#book-growth-audit" class="v5-btn v5-btn-primary v5-btn-lg" data-cta="home-hero-audit">
              Contact us
              <span class="v5-arrow" aria-hidden="true">→</span>
            </a>
            <a href="/case-studies/" class="v5-link-arrow" data-cta="home-hero-case-studies">
              See case studies
            </a>
          </div>
          <p class="v5-hero-note">
            Best fit: {icpFirmographics.arrBand}, founder-led GTM · First call is 20 minutes, free, no pitch
          </p>
        </div>

        <div class="v5-hero-figure">
          <div class="v5-hero-plate" aria-hidden="true"></div>
          <div class="v5-hero-ring" aria-hidden="true"></div>
          <div class="v5-hero-ring v5-hero-ring-outer" aria-hidden="true"></div>
          <Image
            class="v5-hero-portrait"
            src={heroCutout}
            widths={[440, 660, 880]}
            sizes="(max-width: 900px) 74vw, 31rem"
            alt="Daniel Johnson, fractional CMO and AI-native growth operator"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <dl class="v5-hero-stats" aria-label="Track record at a glance">
        <div class="v5-hero-stat">
          <dd>£18M+</dd>
          <dt>Client revenue</dt>
        </div>
        <div class="v5-hero-stat">
          <dd>4.97 / 5</dd>
          <dt>GrowthMentor rating</dt>
        </div>
        <div class="v5-hero-stat">
          <dd>479+</dd>
          <dt>Mentor sessions</dt>
        </div>
        <div class="v5-hero-stat">
          <dd>200+</dd>
          <dt>Startups advised</dt>
        </div>
      </dl>
    </section>

    <!-- ===== Brand bar ===== -->
    <BrandBar />

    <!-- ===== Alt paths (organisers / press) ===== -->
    <div class="v5-altpaths v5-section-tight reveal" aria-label="Also here for speaking or press">
      <div class="v5-container">
        <p>
          Here for something else? <a href="/speaking/" class="v5-link-arrow" data-cta="home-router-speaking">Book a speaker or workshop</a>
          <span class="v5-altpaths-sep">·</span>
          <a href="/media-kit/" class="v5-link-arrow" data-cta="home-router-media">Podcast &amp; press media kit</a>
          <span class="v5-altpaths-sep">·</span>
          <a href={siteConfig.wssPodcastUrl} class="v5-link-arrow" data-cta="home-router-lds" rel="noreferrer" target="_blank">Host of Luck Doesn't Scale</a>
        </p>
      </div>
    </div>

    <!-- ===== Newsletter + WhatsApp community ===== -->
    <section aria-label="Stay in the loop">
      <div class="v5-container reveal">
        <div class="v5-head-stack">
          <span class="v5-eyebrow">Stay in the loop</span>
          <h2 class="v5-h2">Two ways to keep the conversation going.</h2>
          <p class="v5-subhead">Read the thinking between calls, or talk it through with other founders working the same growth problems.</p>
        </div>
        <div class="v5-cta-duo">
          <NewsletterFormInline
            variant="card"
            tone="light"
            heading="Growth Notes: practical notes on founder-led growth, sent when there's something worth saying."
            subline="No daily drip. Unsubscribe in one click."
            idPrefix="nl-home-intro"
          />
          <div class="v5-whatsapp-card">
            <p class="v5-whatsapp-eyebrow">Founder community</p>
            <h3>Trade notes with other founders in the WhatsApp group.</h3>
            <p class="v5-whatsapp-sub">A small, active group working through positioning, pipeline, and GTM calls in real time. No pitching, no noise, just people figuring this out too.</p>
            <!-- v5-btn-primary, not button-accent: the homepage's own primary
                 button style, which keeps white label text under `.v5-home a`. -->
            <WhatsAppCta variant="button" buttonClass="v5-btn v5-btn-primary" dataCta="home-intro-whatsapp" />
          </div>
        </div>
      </div>
    </section>

    <!-- ===== The engine (interactive) ===== -->
    <section aria-label="The growth engine method">
      <div class="v5-container reveal">
        <div class="v5-split-head">
          <div>
            <span class="v5-eyebrow">The engine</span>
            <h2 class="v5-h2">Here's the whole machine, <span class="v5-hl">layer by layer.</span></h2>
          </div>
          <p class="v5-subhead">Six layers, one loop. Customer signal feeds the GTM systems, which drive acquisition, conversion and founder-led distribution, which feed the reporting, which loops straight back into signal.</p>
        </div>
        <div class="v5-engine-grid" data-engine>
          <div class="v5-engine-visual" aria-hidden="true">
            <svg class="v5-engine-svg" viewBox="0 0 520 520" xmlns="http://www.w3.org/2000/svg">
              <circle class="v5-engine-ring" cx="260" cy="260" r="190" />
              <circle class="v5-engine-sweep" cx="260" cy="260" r="190" transform="rotate(-90 260 260)" />
              {engineNodes.map((node, i) => (
                <g class="v5-engine-node" data-engine-node={i.toString()}>
                  <circle cx={node.x} cy={node.y} r="26" />
                  <text x={node.x} y={node.y}>{node.n}</text>
                </g>
              ))}
              <g class="v5-engine-core">
                <text x="260" y="250">The growth</text>
                <text x="260" y="276">engine</text>
                <text class="v5-engine-core-sub" x="260" y="304">ONE LOOP · SIX LAYERS</text>
              </g>
            </svg>
          </div>
          <div class="v5-engine-list">
            {engineNodes.map((node, i) => (
              <a href={node.href} class="v5-engine-item" data-engine-item={i.toString()}>
                <span class="v5-n">{node.n}</span>
                <span>
                  <span class="v5-t">{node.t}</span>
                  <span class="v5-d">{node.d}</span>
                </span>
                <span class="v5-go">→</span>
              </a>
            ))}
          </div>
        </div>
        <div class="v5-engine-footer">
          <p class="v5-engine-text">If "growth engine" sounds abstract, that's the point of the first call. I'll show you what it looks like for your company in 20 minutes.</p>
          <a href="/growth-audit/" class="v5-link-arrow" data-cta="home-method-audit">See what the first 20 minutes covers</a>
        </div>
      </div>
    </section>

    <!-- ===== Bottleneck + interactive diagnosis ===== -->
    <section aria-label="The bottleneck">
      <div class="v5-container reveal">
        <div class="v5-head-stack">
          <span class="v5-eyebrow">The bottleneck</span>
          <h2 class="v5-h2">You already did the hard part. So why does growth still feel like <span class="v5-hl">a coin flip?</span></h2>
          <p class="v5-subhead">The channel is rarely the problem. The growth function still lives in your head, so nothing compounds when you step out of the room.</p>
        </div>
        <div class="v5-bottleneck-block">
          <div class="v5-bottleneck-lead">
            <p>The product works and revenue is moving. You have paying customers and a deck that holds up in a room. And still, three things keep happening.</p>
            <p>The instinct is to add something: a new channel, an agency, another hire. It rarely helps, because there is no system running underneath any of it for the new thing to plug into.</p>
          </div>
          <ol class="v5-symptoms" role="list">
            <li>
              <span class="v5-symptom-n">01</span>
              <span class="v5-symptom-t">Pipeline arrives in bursts</span>
              <span class="v5-symptom-d">Acquisition has plateaued, and pipeline arrives in bursts before going quiet again.</span>
            </li>
            <li>
              <span class="v5-symptom-n">02</span>
              <span class="v5-symptom-t">Every call routes through you</span>
              <span class="v5-symptom-d">Every important growth decision still routes through you, because nobody else has the full picture.</span>
            </li>
            <li>
              <span class="v5-symptom-n">03</span>
              <span class="v5-symptom-t">Nothing compounds</span>
              <span class="v5-symptom-d">Campaigns ship, but nothing connects them, so nothing compounds.</span>
            </li>
          </ol>
        </div>
        <p class="v5-point"><strong>The point:</strong> more activity won't fix this. What moves the number is a senior operator who can see the whole machine at once, name the one or two levers that matter for your company right now, and build the system that keeps pulling them without you.</p>
      </div>
      <div class="v5-container">
        <div class="v5-head-center reveal" style="margin-top: 3rem;">
          <span class="v5-eyebrow">Free · 2 minutes · On-page result</span>
          <h2 class="v5-h2">Not sure which lever is yours? <span class="v5-hl">Find out in two minutes.</span></h2>
          <p class="v5-subhead">Five questions, then a straight read on where your growth is actually stuck. No email, no download, answer on the page.</p>
        </div>
        <div class="v5-diagnosis-wrap">
          <GrowthDiagnosis />
        </div>
      </div>
    </section>

    <!-- ===== Proof ===== -->
    <section id="proof" class="v5-section-proof" aria-label="Proof and case studies">
      <div class="v5-container reveal">
        <div class="v5-head-center">
          <span class="v5-eyebrow">Proof</span>
          <h2 class="v5-h2">Numbers from real campaigns, with the attribution to back them.</h2>
          <p class="v5-subhead">The short list. Full case studies linked below.</p>
        </div>
        <div class="v5-metrics">
          <div class="v5-metric">
            <div class="v5-big" data-countup data-target="6" data-suffix="×">6×</div>
            <div class="v5-top-label">App downloads</div>
            <p class="v5-ctx">2k → 12k+ monthly downloads in six months after an acquisition and lifecycle rebuild.</p>
            <span class="v5-tag">HealthTech · AI</span>
          </div>
          <div class="v5-metric">
            <div class="v5-big" data-countup data-target="35" data-suffix="%">35%</div>
            <div class="v5-top-label">Lower CAC</div>
            <p class="v5-ctx">CAC down 35% in eight weeks. Segmentation, paid account structure, landing-page routing.</p>
            <span class="v5-tag">Fintech · Crypto</span>
          </div>
          <div class="v5-metric">
            <div class="v5-big" data-countup data-target="500" data-suffix="+">500+</div>
            <div class="v5-top-label">Qualified signups</div>
            <p class="v5-ctx">500+ qualified signups from a single campaign at 8.6% CTR. US B2B fintech.</p>
            <span class="v5-tag">Fintech · B2B SaaS</span>
          </div>
          <div class="v5-metric">
            <div class="v5-big" data-countup data-target="21" data-suffix="%">21%</div>
            <div class="v5-top-label">Less churn</div>
            <p class="v5-ctx">Retention up 21% in three months. Targeted lifecycle and win-back messaging.</p>
            <span class="v5-tag">eCommerce</span>
          </div>
        </div>
        <div class="v5-quote-pulled">
          <blockquote>Named the two levers that mattered. Inside 60 days we had a weekly rhythm and pipeline built to our ICP.</blockquote>
          <cite>— Christian A., Founder, AI HealthTech</cite>
        </div>
        <div class="v5-attribution-row">
          <div><strong>£15M+</strong> helped founders raise</div>
          <div><strong>200+</strong> startups across four continents</div>
          <div><strong>4.97 / 5</strong> · <strong>479+</strong> sessions</div>
        </div>
        <div class="v5-center-row">
          <a href="/contact/#book-growth-audit" class="v5-btn v5-btn-ghost" data-cta="home-proof-audit">Contact us</a>
          <a href="/case-studies/" class="v5-link-arrow" data-cta="home-proof-case-studies">See full case studies</a>
        </div>
      </div>
    </section>

    <!-- ===== Productised services ===== -->
    <section aria-label="Ways to work together">
      <div class="v5-container reveal">
        <div class="v5-head-stack">
          <span class="v5-eyebrow">Ways to work together</span>
          <h2 class="v5-h2">Four ways in. <span class="v5-hl">Start with the smallest.</span></h2>
          <p class="v5-subhead">Three steps up, from a free 20-minute call to embedded ownership of the whole growth function, plus one-off sessions when you just need a decision made well. Most founders start at the top and only move on when it's earned.</p>
        </div>
        <div class="v5-ladder">
          <div class="v5-step">
            <div class="v5-step-num">01</div>
            <div class="v5-step-head">
              <span class="v5-tier">Diagnose · Free</span>
              <h3 class="v5-h3">20-min Growth Audit</h3>
              <div class="v5-price">Free</div>
              <p class="v5-meta">20 minutes · No pitch · No deck</p>
            </div>
            <div class="v5-step-copy">
              <p class="v5-body">Bring the messy growth question. We name the bottleneck between us and decide whether working together makes sense, or where else to send you if it doesn't.</p>
              <p class="v5-detail"><span class="v5-lbl">Outcome</span>A clear read on the bottleneck and the most useful next step.</p>
              <div class="v5-cta-row"><a href="/growth-audit/" class="v5-link-arrow" data-cta="home-ladder-audit">See what's covered</a></div>
            </div>
          </div>
          <div class="v5-step">
            <div class="v5-step-num">02</div>
            <div class="v5-step-head">
              <span class="v5-tier">Plan · From £6k</span>
              <h3 class="v5-h3">Strategy Sprint</h3>
              <div class="v5-price">£6k fixed scope</div>
              <p class="v5-meta">2–4 week engagement</p>
            </div>
            <div class="v5-step-copy">
              <p class="v5-body">Diagnose, prioritise, ship the first artefacts: ICP, positioning, 90-day priorities, weekly dashboard, first acquisition or conversion test live.</p>
              <p class="v5-detail"><span class="v5-lbl">Outcome</span>A 90-day growth plan, the first artefacts, and a working operating rhythm.</p>
              <div class="v5-cta-row"><a href="/strategy-sprint/" class="v5-link-arrow" data-cta="home-ladder-sprint">See Strategy Sprint scope</a></div>
            </div>
          </div>
          <div class="v5-step v5-step-emphasis">
            <div class="v5-step-num">03</div>
            <div class="v5-step-head">
              <span class="v5-tier">Build · From £5k/mo</span>
              <h3 class="v5-h3">Fractional CMO <span class="v5-step-flag">Most popular</span></h3>
              <div class="v5-price">From £5k/mo</div>
              <p class="v5-meta">1–2 days a week · 3-month minimum</p>
            </div>
            <div class="v5-step-copy">
              <p class="v5-body">Embedded senior ownership of the growth function. GTM priorities, reporting, weekly rhythm, hiring and agency calls. Build the engine, hand it off clean.</p>
              <p class="v5-detail"><span class="v5-lbl">Outcome</span>Pipeline rhythm, sharper positioning, and an engine the team runs after I'm gone.</p>
              <div class="v5-cta-row"><a href="/fractional-cmo/" class="v5-link-arrow" data-cta="home-ladder-cmo">Explore Fractional CMO</a></div>
            </div>
          </div>
          <div class="v5-step v5-step-secondary">
            <div class="v5-step-num">04</div>
            <div class="v5-step-head">
              <span class="v5-tier">Advise · Per session</span>
              <h3 class="v5-h3">Founder Office Hours</h3>
              <div class="v5-price">Flexible</div>
              <p class="v5-meta">Focused 1:1 working sessions</p>
            </div>
            <div class="v5-step-copy">
              <p class="v5-body">A senior second brain for specific GTM decisions: pricing, positioning, hiring calls, channel bets. No retainer and no ramp, just the decision made well.</p>
              <p class="v5-detail"><span class="v5-lbl">Outcome</span>A confident call on the decision in front of you, with the reasoning.</p>
              <div class="v5-cta-row"><a href="/founder-office-hours/" class="v5-link-arrow" data-cta="home-ladder-office-hours">See Office Hours</a></div>
            </div>
          </div>
        </div>
        <p class="v5-ladder-footer">
          After a talk or a workshop instead? <a href="/speaking/">Speaking and workshops live here</a>, and
          <a href="/work-with-me/" class="v5-link-arrow" data-cta="home-ladder-all">the full list of ways to work together is here</a>
        </p>
      </div>
    </section>

    <!-- ===== Fit ===== -->
    <section aria-label="Fit check">
      <div class="v5-container reveal">
        <div class="v5-split-head">
          <div>
            <span class="v5-eyebrow">Fit</span>
            <h2 class="v5-h2">Who this is for, and who it isn't.</h2>
          </div>
          <p class="v5-subhead">I'd rather save us both a 20-minute call if we're not the right match.</p>
        </div>
        <div class="v5-fit">
          <div class="v5-fit-col v5-fit-yes">
            <div class="v5-lbl-tag">Best fit</div>
            <ul>
              <li><span class="v5-icon">✓</span><span>£1M–£20M ARR B2B SaaS or AI, ~10–50 people, founder still running GTM</span></li>
              <li><span class="v5-icon">✓</span><span>Seed to Series B, post-PMF, real customers, real revenue</span></li>
              <li><span class="v5-icon">✓</span><span>Founder bottlenecked on growth decisions</span></li>
              <li><span class="v5-icon">✓</span><span>Need senior operator judgement, not junior execution</span></li>
              <li><span class="v5-icon">✓</span><span>Ready to invest in systems, not campaigns</span></li>
            </ul>
          </div>
          <div class="v5-fit-col v5-fit-no">
