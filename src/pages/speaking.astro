---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import CfEmailOff from "../components/CfEmailOff.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import speakingMicImg from "../assets/images/daniel-speaking-mic.webp";
import speakingStageBwImg from "../assets/images/daniel-speaking-stage-bw.webp";
import speakingCircleImg from "../assets/images/daniel-speaking-circle.webp";
import cambridgeJudgeImg from "../assets/images/cambridge-judge-business-school-960.webp";
import { buildBreadcrumbSchema, buildTalkSchema } from "../lib/schema";
import { sortByFeaturedThenOrder } from "../lib/utils";
import { proofStats, siteConfig, speakingVideos, trustLogos } from "../site";

const talks = sortByFeaturedThenOrder(await getCollection("talks"));

const speakingHighlights = [
  { metric: "20+", label: "Talks, workshops and masterclasses" },
  { metric: proofStats.mentorSessions, label: "Founder and operator mentoring sessions" },
  { metric: `${proofStats.mentorRating}/5`, label: `Average rating from ${proofStats.mentorReviewCount}+ reviews` },
  { metric: "10+ countries", label: "Startup audiences reached through teaching and mentoring" }
];

const selectedAppearances = [
  {
    year: "2026",
    organisation: "Nomad Summit · Chiang Mai",
    title: "What Two Exits and Too Many Failures Taught Me About Growing Successful Companies",
    detail: "A founder-focused talk on the mistakes, assumptions and lessons behind building, scaling, failing and exiting companies."
  },
  {
    year: "2026",
    organisation: "UK Department for Business & Trade",
    title: "Building a Team and Founder-Led Growth: From First Hire to First Advocates",
    detail: "How founders turn early founder-led momentum into a team and growth system without losing customer insight or speed."
  },
  {
    year: "2026",
    organisation: "UK Department for Business & Trade",
    title: "Ideas to Reality: Validating Your Product and Finding Market Fit",
    detail: "A practical founder workshop on testing ideas before overbuilding and separating real market signal from polite feedback."
  },
  {
    year: "2026",
    organisation: "Foundervine · Immerse Catalyst",
    title: "Marketing for Growth: Expanding Sales and Revenue",
    detail: "An interactive masterclass helping founders diagnose where growth is stuck and connect marketing activity to revenue."
  },
  {
    year: "2026",
    organisation: "Shenzhen SaaS & AI founder event",
    title: "Building a Growth System Tied to Revenue",
    detail: "A session on connecting positioning, distribution, experimentation and reporting to the commercial outcomes that matter."
  },
  {
    year: "2025",
    organisation: "CHSI Stitches · NEC Birmingham",
    title: "From Art to Cart: Converting Creativity Into Sales Through Digital Marketing",
    detail: "A practical session on positioning, customer understanding and digital distribution for creative businesses."
  },
  {
    year: "2024",
    organisation: "Mayple",
    title: "Game Changing Talent: How to Hire the Best Marketers",
    detail: "What founders should look for when hiring marketers, and why hiring around channels rather than problems often goes wrong."
  },
  {
    year: "2023",
    organisation: "MEST Africa",
    title: "How to Use Growth Hacking to Grow Business Revenue for African Startups",
    detail: "A hands-on workshop for entrepreneurs and startup teams, delivered to 68 attendees."
  },
  {
    year: "2021",
    organisation: "Qualcomm + Techstars",
    title: "Going Global: Europe",
    detail: "A session for Taiwanese startups on entering European markets, localisation, positioning and international expansion mistakes."
  },
  {
    year: "2021",
    organisation: "Imperial College London",
    title: "Turning Ideas Into Startups That Can Scale",
    detail: "A founder workshop covering startup creation, positioning, validation and early-stage growth."
  },
  {
    year: "2020",
    organisation: "General Assembly Middle East",
    title: "Data-Driven Marketing",
    detail: "A practical training session on using data to make better marketing decisions."
  }
];

const signatureSessions = [
  {
    title: "What the Hell Is Growth?",
    subtitle: "How to build a growth system instead of collecting growth hacks",
    outcome: "A practical way to diagnose where growth is actually stuck, decide what matters and build a repeatable experimentation process.",
    bestFor: "Founders, startup teams and accelerators"
  },
  {
    title: "Positioning Before Pipeline",
    subtitle: "Why your lead problem might actually be a positioning problem",
    outcome: "How to diagnose ICP, category and messaging issues before pouring more money into acquisition.",
    bestFor: "B2B SaaS, AI startups and GTM teams"
  },
  {
    title: "Founder-Led Growth",
    subtitle: "What happens after the founder gets the first customers?",
    outcome: "How founders capture what is working, turn customer insight into repeatable processes and stop becoming the commercial bottleneck.",
    bestFor: "Post-PMF Seed to Series B founders"
  },
  {
    title: "AI-Native GTM",
    subtitle: "How small teams can use AI without outsourcing their judgement",
    outcome: "Where AI genuinely improves research, positioning, experimentation and sales workflows, and where human judgement still matters.",
    bestFor: "AI companies, SaaS teams and innovation programmes"
  },
  {
    title: "What Two Exits and Too Many Failures Taught Me",
    subtitle: "The things I wish somebody had told me earlier",
    outcome: "A story-led founder session on the mistakes, assumptions and uncomfortable lessons behind building and growing companies.",
    bestFor: "Founder conferences and entrepreneurship events"
  }
];

const sessionFormats = [
  {
    title: "Keynote",
    length: "20–45 minutes",
    detail: "For conferences, company events and founder communities. Focused around one clear idea and a practical takeaway."
  },
  {
    title: "Workshop",
    length: "60–120 minutes",
    detail: "Exercises, examples, audience questions and practical implementation for accelerators, portfolios and startup teams."
  },
  {
    title: "Founder / portfolio session",
    length: "Half day or customised",
    detail: "Teaching, live diagnosis, office hours and individual startup feedback for a specific founder cohort."
  },
  {
    title: "Panel / moderation",
    length: "Custom format",
    detail: "Founder conversations, expert panels, interviews and Q&A around growth, AI, SaaS, entrepreneurship and go-to-market."
  }
];

const organiserTakeaways = [
  "Audience research before the event so examples match the room.",
  "Real startup examples rather than only billion-dollar brand case studies.",
  "Practical frameworks, live Q&A and optional startup or GTM teardowns.",
  "Slides, worksheets or follow-up resources where they make the session more useful."
];

const bestAudiences = [
  "Startup founders",
  "Accelerators and VC portfolios",
  "University entrepreneurship programmes",
  "Corporate innovation teams",
  "Marketing and growth teams",
  "Founder communities and conferences"
];

const organiserFeedback = [
  {
    organisation: "MEST Africa",
    quote: "The organiser described the workshop as enlightening, engaging, enjoyable and valuable to attendees.",
    note: "68 attendees across entrepreneurs in training, staff, portfolio companies and community members."
  },
  {
    organisation: "General Assembly",
    quote: "The organiser reported great feedback after the event and asked about bringing Daniel back for future workshops.",
    note: "Data-Driven Marketing · General Assembly Middle East"
  }
];

const eventPhotos = [
  {
    src: speakingStageBwImg,
    alt: "Daniel Johnson speaking on stage",
    caption: "Live conference and founder sessions"
  },
  {
    src: speakingMicImg,
    alt: "Daniel Johnson presenting during a startup growth session",
    caption: "Practical startup growth workshops"
  },
  {
    src: speakingCircleImg,
    alt: "Daniel Johnson speaking with a microphone during a founder session",
    caption: "Founder Q&A and interactive sessions"
  },
  {
    src: cambridgeJudgeImg,
    alt: "Cambridge Judge Business School",
    caption: "Teaching at Cambridge Judge Business School"
  }
];

const featuredVideos = speakingVideos.slice(0, 3);

const speakingSchema = [
  buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Speaking", url: "/speaking/" }
  ]),
  ...talks.map((talk) => buildTalkSchema(talk))
];
---

<BaseLayout
  stickyCtaLabel="Ask about speaking availability →"
  stickyCtaHref={`mailto:${siteConfig.email}?subject=Speaking%20enquiry%20for%20Daniel%20Johnson`}
  stickyCtaHint="Conferences · accelerators · universities · teams"
  description="Book Daniel Johnson for practical startup growth talks, founder workshops, accelerator sessions and GTM training. 20+ talks and workshops across startup ecosystems, universities and founder communities."
  path="/speaking/"
  schema={speakingSchema}
  title="Startup Growth Speaker & Workshop Facilitator | Daniel Johnson"
>
  <section class="section-space">
    <div class="shell">
      <div class="grid items-center gap-10 lg:grid-cols-[1.08fr_0.92fr]">
        <div class="reveal space-y-6">
          <span class="service-label">Speaking / Workshops</span>
          <h1 class="max-w-5xl text-5xl font-bold tracking-[-0.06em] text-balance md:text-7xl">
            Practical startup growth talks founders can actually use on Monday.
          </h1>
          <p class="max-w-3xl text-lg leading-9 text-[color:var(--muted)] md:text-xl">
            I&apos;m Daniel Johnson, a founder, fractional CMO and startup growth mentor. I&apos;ve delivered 20+ talks,
            workshops and masterclasses for founders and operators through organisations including Google for Startups,
            Techstars, Cambridge Judge Business School, Imperial College London, the UK Department for Business & Trade,
            MEST Africa, General Assembly and Nomad Summit.
          </p>
          <p class="max-w-3xl text-base leading-8 text-[color:var(--muted)]">
            No motivational filler and no generic playbook copied from companies with billion-dollar budgets. I focus on
            practical frameworks, real examples and what the audience should do differently next.
          </p>
          <div class="flex flex-wrap gap-3 pt-2">
            <CfEmailOff>
              <a class="button-accent" href={`mailto:${siteConfig.email}?subject=Speaking%20enquiry%20for%20Daniel%20Johnson`}>
                Book Daniel to speak →
              </a>
            </CfEmailOff>
            <a class="button-secondary" href="#selected-speaking">See past talks ↓</a>
            <a class="button-link" href="/media-kit/">Speaker kit →</a>
          </div>
        </div>

        <aside class="reveal overflow-hidden rounded-[2rem] border border-[color:var(--line)] bg-[color:var(--surface)]">
          <Image
            src={speakingStageBwImg}
            alt="Daniel Johnson speaking on stage at a live event"
            widths={[640, 900, 1200]}
            sizes="(min-width: 1024px) 42vw, 100vw"
            class="aspect-[4/4.5] h-full w-full object-cover"
          />
        </aside>
      </div>

      <div class="mt-10 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        {speakingHighlights.map((item) => (
          <article class="reveal card p-5">
            <p class="text-3xl font-bold tracking-[-0.04em]">{item.metric}</p>
            <p class="mt-3 text-sm leading-6 text-[color:var(--muted)]">{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <nav aria-label="On this page" class="border-y border-[color:var(--line)]">
    <div class="shell">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 py-4 text-sm font-semibold">
        <li><a class="text-[color:var(--muted)] transition-colors hover:text-[color:var(--ink)]" href="#selected-speaking">Selected speaking</a></li>
        <li><a class="text-[color:var(--muted)] transition-colors hover:text-[color:var(--ink)]" href="#topics">Talks</a></li>
        <li><a class="text-[color:var(--muted)] transition-colors hover:text-[color:var(--ink)]" href="#formats">Formats</a></li>
        <li><a class="text-[color:var(--muted)] transition-colors hover:text-[color:var(--ink)]" href="#feedback">Feedback</a></li>
        <li><a class="text-[color:var(--muted)] transition-colors hover:text-[color:var(--ink)]" href="#videos">Videos</a></li>
        <li><a class="text-[color:var(--accent)]" href={`mailto:${siteConfig.email}?subject=Speaking%20enquiry%20for%20Daniel%20Johnson`}>Enquire →</a></li>
      </ul>
    </div>
  </nav>

  <section id="selected-speaking" class="scroll-mt-24 section-space">
    <div class="shell">
      <SectionHeader
        eyebrow="Selected speaking"
        intro="A sample of delivered talks and workshops. The full archive includes recurring programmes, panels and earlier sessions."
        title="Real rooms, real founders, practical sessions."
      />

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {selectedAppearances.map((item) => (
          <article class="reveal card p-6 md:p-7">
            <div class="flex items-start justify-between gap-5">
              <p class="card-label">{item.organisation}</p>
              <span class="rounded-full border border-[color:var(--line)] px-3 py-1 text-xs font-bold text-[color:var(--muted)]">{item.year}</span>
            </div>
            <h2 class="mt-4 text-2xl font-bold tracking-[-0.04em] text-balance">{item.title}</h2>
            <p class="mt-4 leading-7 text-[color:var(--muted)]">{item.detail}</p>
          </article>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a class="button-secondary" href="/speaking/archive/">View the full speaking archive →</a>
        <p class="text-sm leading-6 text-[color:var(--muted)]">Includes earlier and recurring work with Google Launchpad, Cambridge Judge, UK Space Agency and more.</p>
      </div>

      <div class="mt-12">
        <p class="mb-5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--muted)]">Talks, workshops and founder sessions delivered through</p>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {trustLogos.map((item) => (
            <article class="reveal logo-card flex items-center justify-between gap-4 px-5 py-4">
              <img
                alt={item.alt}
                class="h-9 w-auto max-w-[9rem] object-contain opacity-80 grayscale"
                data-hide-on-error
                height="48"
                loading="lazy"
                src={item.src}
                width="180"
              />
              <span class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[color:var(--muted)]">{item.label}</span>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell">
      <SectionHeader
        eyebrow="Event photography"
        intro="Speaking works better when it feels like a conversation with the room, not a lecture at it."
        title="On stage, in workshops and inside founder cohorts."
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {eventPhotos.map((photo) => (
          <figure class="reveal overflow-hidden rounded-[1.5rem] border border-[color:var(--line)] bg-[color:var(--surface)]">
            <Image src={photo.src} alt={photo.alt} widths={[420, 640, 900]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="aspect-square w-full object-cover" />
            <figcaption class="px-4 py-4 text-sm font-semibold leading-6">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="topics" class="scroll-mt-24 section-space pt-0">
    <div class="shell">
      <SectionHeader
        eyebrow="Signature talks"
        intro="I do not force the same keynote into every room. These are the themes I speak about most often, then I tailor examples and depth to the audience."
        title="Start with the problem the room actually has."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {signatureSessions.map((item) => (
          <article class="reveal card p-6 md:p-7">
            <p class="card-label">{item.bestFor}</p>
            <h2 class="mt-4 text-2xl font-bold tracking-[-0.04em]">{item.title}</h2>
            <p class="mt-3 font-semibold leading-7">{item.subtitle}</p>
            <p class="mt-4 leading-7 text-[color:var(--muted)]">{item.outcome}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="formats" class="scroll-mt-24 section-space pt-0">
    <div class="shell">
      <SectionHeader
        eyebrow="Formats"
        intro="The format should match what the audience needs to leave with, not just the slot on the agenda."
        title="Keynotes when you need one idea. Workshops when you need behaviour change."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {sessionFormats.map((item) => (
          <article class="reveal card p-6">
            <p class="card-label">{item.length}</p>
            <h2 class="mt-4 text-2xl font-bold tracking-[-0.04em]">{item.title}</h2>
            <p class="mt-4 leading-7 text-[color:var(--muted)]">{item.detail}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <h3 class="text-3xl font-bold tracking-[-0.05em]">What organisers get.</h3>
          <p class="mt-4 max-w-xl leading-8 text-[color:var(--muted)]">
            I want the organiser to know exactly what the audience will leave with before the session is booked.
          </p>
        </div>
        <ul class="scan-list">
          {organiserTakeaways.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell">
      <SectionHeader
        eyebrow="Audience fit"
        intro="The sessions land best when the audience has real commercial decisions to make, not when they only need inspiration."
        title="Who I speak to."
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {bestAudiences.map((item) => (
          <article class="reveal card p-5">
            <p class="text-base font-bold leading-7 tracking-[-0.02em]">{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="feedback" class="scroll-mt-24 section-space pt-0">
    <div class="shell">
      <SectionHeader
        eyebrow="Organiser feedback"
        intro="I prefer specific organiser evidence over anonymous praise. These are paraphrased from post-session feedback and correspondence."
        title="Useful enough to be invited back."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {organiserFeedback.map((item) => (
          <article class="reveal card p-7">
            <p class="card-label">{item.organisation}</p>
            <p class="mt-5 text-xl font-semibold leading-8">{item.quote}</p>
            <p class="mt-5 text-sm leading-6 text-[color:var(--muted)]">{item.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {featuredVideos.length > 0 && (
    <section id="videos" class="scroll-mt-24 section-space pt-0">
      <div class="shell">
        <SectionHeader
          eyebrow="Speaking videos"
          intro="See the delivery style before you book."
          title="Watch a session, not a showreel."
        />
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {featuredVideos.map((video) => (
            <article class="reveal video-panel">
              <div class="video-frame">
                <iframe
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  loading="lazy"
                  src={video.embed}
                  title={video.title}
                />
              </div>
              <div class="video-panel-copy">
                <p class="card-label">{video.source}</p>
                <h2>{video.title}</h2>
                <p>{video.description}</p>
                <a class="link-arrow" href={video.href} rel="noreferrer" target="_blank">Watch on YouTube</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-space pt-0">
    <div class="shell">
      <div class="grid gap-8 rounded-[2rem] border border-[color:var(--line)] bg-[color:var(--surface)] p-7 md:p-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <span class="service-label">About Daniel</span>
          <h2 class="mt-5 text-4xl font-bold tracking-[-0.055em] text-balance md:text-5xl">Growth work first. Speaking built from it.</h2>
        </div>
        <div class="space-y-5 text-base leading-8 text-[color:var(--muted)]">
          <p>
            I&apos;ve spent most of my career trying to understand why some companies grow and others do not. I started my first
            business young, went on to build and exit companies, worked across startups and larger organisations, and founded We Scale Startups.
          </p>
          <p>
            Today I work primarily with AI and B2B SaaS companies on positioning, acquisition and repeatable growth systems.
            Speaking is where I turn those lessons, including the failures, into something another founder can use immediately.
          </p>
          <p class="font-semibold text-[color:var(--foreground)]">
            If an attendee leaves with twelve pages of notes but no idea what to do next, the session has not worked.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell">
      <div class="reveal rounded-[2rem] border border-[color:var(--line)] bg-[color:var(--ink)] p-7 text-white md:p-10 lg:p-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-white/60">Planning an event?</p>
            <h2 class="mt-4 max-w-4xl text-4xl font-bold tracking-[-0.055em] text-balance md:text-6xl">Tell me who is in the room and what you want them to leave knowing.</h2>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-white/70">
              I speak at conferences, startup accelerators, VC portfolio programmes, universities, founder communities and company events in the UK and internationally.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:flex-col lg:items-stretch">
            <CfEmailOff>
              <a class="button-accent" href={`mailto:${siteConfig.email}?subject=Speaking%20enquiry%20for%20Daniel%20Johnson`}>
                Ask about speaking availability →
              </a>
            </CfEmailOff>
            <a class="button-secondary border-white/20 text-white hover:bg-white/10" href="/media-kit/">Download speaker kit →</a>
            <a class="button-link text-white" href="/speaking/archive/">Full speaking archive →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
