---
import { getCollection } from "astro:content";
import SectionHeader from "../components/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema } from "../lib/schema";
import { sortByFeaturedThenOrder } from "../lib/utils";

const schema = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Now", url: "/now/" }
]);

const updatedOn = "26 August 2026";

const workingOn = [
  {
    title: "Fractional CMO work across AI-native B2B SaaS",
    detail: "Positioning, GTM cadence, reporting, AI-native workflows, and moving growth decisions from founder-dependent activity into a repeatable operating system."
  },
  {
    title: "Productised growth systems",
    detail: "Sharpening the delivery system behind growth audits, strategy sprints, experimentation, and embedded fractional work so the output is useful after the engagement ends."
  },
  {
    title: "Founder advisory",
    detail: "Focused sessions on positioning, channel bets, hiring, measurement, and the growth decisions that are expensive to get wrong."
  }
];

const writingFocus = [
  "AI-native GTM systems: where automation helps, where it creates noise, and where judgement still matters.",
  "Founder-dependent growth: how to diagnose the real bottleneck before adding channels, tools, or headcount.",
  "Case-study write-ups that show the before-and-after operating system, not just the headline metric."
];

const speakingThisQuarter = [
  "Founder and accelerator workshops on repeatable growth systems and practical GTM decisions.",
  "Podcast and media conversations on AI-native GTM, startup growth, and fractional leadership.",
  "Ongoing mentoring through startup and founder communities."
];

const notWorkingOn = [
  "Pre-PMF growth execution: customer research and product signal come first.",
  "Channel-only retainers where there is no authority to fix positioning, funnel, measurement, or operating cadence.",
  "Vanity-metric reporting or activity for activity's sake."
];

const articles = sortByFeaturedThenOrder(await getCollection("articles")).slice(0, 3);
---

<BaseLayout
  description="What Daniel Johnson is working on now: fractional CMO work, AI-native GTM systems, founder advisory, writing, speaking, and current priorities."
  path="/now/"
  schema={schema}
  title="Now | Daniel Johnson"
  lastUpdated={false}
>
  <section class="hero-section section-space">
    <div class="shell">
      <div class="reveal mx-auto max-w-4xl space-y-6">
        <span class="service-label">Now · updated {updatedOn}</span>
        <h1 class="text-5xl font-extrabold leading-[1.02] tracking-[-0.07em] text-balance md:text-7xl">
          What I'm working on right now.
        </h1>
        <p class="hero-subcopy text-xl leading-9 md:text-2xl">
          A current view of the client work, systems, writing, speaking, and priorities taking most of my attention.
          Inspired by <a class="underline" href="https://nownownow.com/about" rel="noopener">Derek Sivers' /now page idea</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="shell">
      <SectionHeader eyebrow="Current work" title="Where most of my working time is going." />
      <div class="reveal mx-auto grid max-w-5xl gap-6 md:grid-cols-2 lg:grid-cols-3">
        {workingOn.map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="text-lg font-semibold leading-snug">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space bg-slate-50">
    <div class="shell">
      <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-extrabold tracking-[-0.03em]">Writing</h2>
          <ul class="mt-5 space-y-3 text-base leading-7">
            {writingFocus.map((item) => (
              <li class="flex gap-3">
                <span class="mt-3 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-slate-900"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a class="button-link mt-6 inline-block" href="/writing/">See recent essays →</a>
        </div>
        <div>
          <h2 class="text-3xl font-extrabold tracking-[-0.03em]">Speaking</h2>
          <ul class="mt-5 space-y-3 text-base leading-7">
            {speakingThisQuarter.map((item) => (
              <li class="flex gap-3">
                <span class="mt-3 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-slate-900"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a class="button-link mt-6 inline-block" href="/speaking/">See speaking topics →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="shell">
      <SectionHeader eyebrow="Saying no to" title="Work that does not fit the operating model." />
      <div class="reveal mx-auto max-w-3xl">
        <ul class="space-y-4 text-lg leading-8">
          {notWorkingOn.map((item) => (
            <li class="flex gap-3">
              <span class="mt-3 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-slate-500"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section-space bg-slate-50">
      <div class="shell">
        <SectionHeader eyebrow="Recent writing" title="What I've published most recently." />
        <div class="reveal mx-auto grid max-w-5xl gap-6 md:grid-cols-3">
          {articles.map((article) => (
            <a class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-slate-900" href={`/writing/${article.id}/`}>
              <h3 class="text-lg font-semibold leading-snug group-hover:underline">{article.data.title}</h3>
              {article.data.description && (
                <p class="mt-3 text-sm leading-7 text-slate-600">{article.data.description}</p>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-space bg-slate-900 text-white">
    <div class="shell">
      <div class="reveal mx-auto max-w-3xl space-y-6 text-center">
        <h2 class="text-4xl font-extrabold tracking-[-0.04em] md:text-5xl">Working on a similar growth problem?</h2>
        <p class="text-lg text-slate-200">
          Start with the 20-minute Growth Audit. Bring the messy question, leave with a clearer read on the bottleneck and the next move.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a class="button-primary" href="/contact/#book-growth-audit">Talk to Daniel</a>
          <a class="button-link text-white" href="/fractional-cmo/">See the fractional CMO offer →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
