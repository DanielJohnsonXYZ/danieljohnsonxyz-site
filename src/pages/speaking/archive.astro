---

<BaseLayout
  stickyCtaLabel="Ask about speaking availability →"
  stickyCtaHref={`mailto:${siteConfig.email}?subject=Speaking%20enquiry%20for%20Daniel%20Johnson`}
  stickyCtaHint="Conferences · accelerators · universities · teams"
  description="Chronological speaking archive for Daniel Johnson, including startup growth talks, founder workshops, accelerator sessions and university programmes."
  path="/speaking/archive/"
  schema={schema}
  title="Speaking Archive | Daniel Johnson"
>
  <section class="section-space">
    <div class="shell">
      <div class="max-w-4xl">
        <span class="service-label">Speaking archive</span>
        <h1 class="mt-6 text-5xl font-bold tracking-[-0.06em] text-balance md:text-7xl">Talks, workshops and founder sessions.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-9 text-[color:var(--muted)] md:text-xl">
          A chronological record of delivered speaking engagements I can substantiate from event pages, archived site records,
          calendar history and organiser correspondence. Recurring programmes with incomplete historical dates are listed separately.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="button-secondary" href="/speaking/">← Back to speaking</a>
          <CfEmailOff>
            <a class="button-accent" href={`mailto:${siteConfig.email}?subject=Speaking%20enquiry%20for%20Daniel%20Johnson`}>Book Daniel to speak →</a>
          </CfEmailOff>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell space-y-14">
      {years.map((group) => (
        <section aria-labelledby={`year-${group.year}`} class="grid gap-6 lg:grid-cols-[11rem_1fr]">
          <div>
            <h2 id={`year-${group.year}`} class="sticky top-24 text-4xl font-bold tracking-[-0.05em]">{group.year}</h2>
          </div>
          <div class="grid gap-4">
            {group.items.map((item) => (
              <article class="reveal card p-6 md:p-7">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <p class="card-label">{item.organisation}</p>
                  <span class="text-xs font-semibold text-[color:var(--muted)]">{item.date}</span>
                  <span class="text-xs font-semibold text-[color:var(--muted)]">{item.format}</span>
                </div>
                <h3 class="mt-4 text-2xl font-bold tracking-[-0.04em] text-balance">{item.title}</h3>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell">
      <SectionHeader
        eyebrow="Earlier and recurring"
        intro="These engagements are supported by historical speaking records, but the exact delivery date is not always preserved."
        title="Programmes and rooms that pre-date the clean archive."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {recurring.map((item) => (
          <article class="reveal card p-6 md:p-7">
            <p class="card-label">{item.organisation}</p>
            <h2 class="mt-4 text-2xl font-bold tracking-[-0.04em]">{item.title}</h2>
            <p class="mt-4 leading-7 text-[color:var(--muted)]">{item.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell">
      <div class="reveal rounded-[2rem] border border-[color:var(--line)] bg-[color:var(--ink)] p-7 text-white md:p-10 lg:p-12">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-white/60">Planning an event?</p>
        <h2 class="mt-4 max-w-4xl text-4xl font-bold tracking-[-0.055em] text-balance md:text-6xl">The archive is proof. The session should still be designed around your room.</h2>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-white/70">
          Send the audience, format and problem you want the session to solve. I&apos;ll recommend the strongest angle rather than forcing a stock keynote into the agenda.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <CfEmailOff>
            <a class="button-accent" href={`mailto:${siteConfig.email}?subject=Speaking%20enquiry%20for%20Daniel%20Johnson`}>Ask about speaking availability →</a>
          </CfEmailOff>
          <a class="button-secondary border-white/20 text-white hover:bg-white/10" href="/media-kit/">Speaker kit →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
