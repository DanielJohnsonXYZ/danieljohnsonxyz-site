---
import LeadMagnetForm from "../components/LeadMagnetForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildFaqPageSchema, buildHowToSchema } from "../lib/schema";

const steps = [
  {
    number: "01",
    title: "Map decisions, not tasks",
    copy: "Separate founder judgement, shared strategic decisions, and routine operating ownership."
  },
  {
    number: "02",
    title: "Install a weekly rhythm",
    copy: "Create fixed moments to read evidence, brief work, ship, and make a keep, change, stop, or scale decision."
  },
  {
    number: "03",
    title: "Run a visible decision queue",
    copy: "Give every open decision one owner, a deadline, and a clear statement of whether founder input is actually needed."
  },
  {
    number: "04",
    title: "Hand off in two stages",
    copy: "Transfer context and thresholds through a shadow week and a reverse-shadow week before removing the founder approval."
  }
];

const contents = [
  "Start Here dashboard for the 90-day goal, founder-only judgement, intended handoffs, and system health",
  "Ownership Map that separates current owner, intended owner, founder role, readiness, and next evidence",
  "Weekly Rhythm with Monday signal, Wednesday ship, Friday decision, and monthly reallocation moments",
  "Decision Queue that makes waiting on the founder visible",
  "Ten-question Founder Dependency Check with an automatic score and interpretation",
  "Handoff Plan for context, thresholds, shadowing, reverse-shadowing, and review",
  "Three-page PDF guide that explains the operating logic and a four-week installation sequence"
];

const faq = [
  {
    question: "Is this another founder productivity scorecard?",
    answer:
      "No. The workbook maps operating ownership and installs a decision rhythm. The dependency check is one supporting sheet, not the offer."
  },
  {
    question: "Who is it for?",
    answer:
      "Founders and small leadership teams with real traction where important growth work still slows down whenever the founder becomes unavailable."
  },
  {
    question: "What happens after signup?",
    answer:
      "You get the Excel workbook and PDF guide immediately, followed by five practical emails over 16 days that help you install the system one layer at a time."
  }
];

const schemas = [
  buildFaqPageSchema(faq),
  buildHowToSchema({
    name: "How to install a founder-led growth operating system",
    description: "Map decision ownership, install a weekly rhythm, make waiting visible, and hand off routine growth decisions without losing founder judgement.",
    url: "/founder-led-growth-operating-system/",
    steps: steps.map((step) => ({ name: step.title, text: step.copy }))
  })
];
---

<BaseLayout
  title="Founder-Led Growth Operating System | Daniel Johnson"
  description="Free editable workbook and field guide for keeping founder judgement where it adds leverage while removing the founder as the default growth bottleneck."
  path="/founder-led-growth-operating-system/"
  schema={schemas}
>
  <section class="section-space">
    <div class="shell">
      <div class="reveal mx-auto max-w-5xl">
        <span class="service-label">Free operating system</span>
        <h1 class="mt-5 text-5xl font-extrabold leading-[1.01] tracking-[-0.075em] text-balance md:text-7xl">
          Founder-led growth without making the founder the operating system.
        </h1>
        <p class="hero-subcopy mt-6 max-w-4xl text-xl leading-9 md:text-2xl">
          Keep the category judgement, customer context, and strategic trade-offs that only you can own.
          Build a weekly decision rhythm the team can run without waiting for you.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button-accent" href="#get-the-system" data-cta="flgos-hero-get-system">
            Get the workbook + guide →
          </a>
          <a class="button-secondary" href="#inside" data-cta="flgos-hero-inside">See what is inside ↓</a>
        </div>
        <p class="mt-3 text-sm text-[color:var(--muted)]">Editable Excel workbook · 3-page guide · Free</p>
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell">
      <div class="reveal card-muted grid gap-8 p-6 md:grid-cols-[0.8fr_1.2fr] md:p-10">
        <div>
          <p class="card-label">The operating distinction</p>
          <h2 class="mt-4 text-4xl font-bold tracking-[-0.05em] md:text-5xl">
            Founder-led is useful. Founder-dependent is expensive.
          </h2>
        </div>
        <div class="grid gap-4 text-base leading-8 text-[color:var(--muted)]">
          <p>
            Founders carry context, taste, category judgement, and relationships that should not be delegated casually.
            The problem begins when campaign briefs, weekly sequencing, vendor direction, and routine trade-offs also wait for the founder.
          </p>
          <p>
            This system helps you decide what stays founder-owned, what becomes shared, and what should move to an internal owner with explicit thresholds.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space pt-0" id="inside">
    <div class="shell">
      <div class="reveal max-w-3xl">
        <p class="card-label">Inside the system</p>
        <h2 class="mt-4 text-4xl font-bold tracking-[-0.05em] md:text-6xl">
          Six working sheets, not a decorative PDF funnel.
        </h2>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {contents.map((item, index) => (
          <article class="reveal card p-6 md:p-7">
            <span class="text-sm font-bold text-[color:var(--accent)]">{String(index + 1).padStart(2, "0")}</span>
            <p class="mt-3 text-base font-semibold leading-7">{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell">
      <div class="reveal max-w-3xl">
        <p class="card-label">The installation sequence</p>
        <h2 class="mt-4 text-4xl font-bold tracking-[-0.05em] md:text-6xl">
          Move one decision layer at a time.
        </h2>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {steps.map((step) => (
          <article class="reveal card p-6 md:p-8">
            <span class="text-sm font-bold text-[color:var(--accent)]">{step.number}</span>
            <h3 class="mt-3 text-2xl font-bold tracking-[-0.04em]">{step.title}</h3>
            <p class="mt-3 text-base leading-8 text-[color:var(--muted)]">{step.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space pt-0" id="get-the-system">
    <div class="shell">
      <LeadMagnetForm
        formId="4"
        idPrefix="founder-led-growth-operating-system"
        heading="Send me the Founder-Led Growth Operating System"
        subline="Get the editable workbook, the concise field guide, and five implementation emails that help you map ownership and remove the first recurring founder bottleneck."
        buttonLabel="Get the system →"
      />
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell">
      <div class="reveal mx-auto max-w-4xl">
        <p class="card-label">FAQ</p>
        <h2 class="mt-4 text-4xl font-bold tracking-[-0.05em]">What this is—and is not.</h2>
        <div class="mt-6 grid gap-3">
          {faq.map((item) => (
            <details class="card p-5">
              <summary class="cursor-pointer font-semibold">{item.question}</summary>
              <p class="mt-3 text-base leading-8 text-[color:var(--muted)]">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
