---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { buildBreadcrumbSchema, buildFaqPageSchema, buildServiceSchema } from "../lib/schema";
import { absoluteUrl } from "../lib/utils";
import { afterYouBookSteps, ctas, growthAuditPage, growthAuditSampleOutput } from "../site";

const schemas = [
  buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Start here", url: "/start-here/" },
    { name: "20-min Growth Audit", url: "/growth-audit/" }
  ]),
  buildFaqPageSchema([...growthAuditPage.faq]),
  buildServiceSchema({
    name: "20-minute Growth Audit",
    description:
      "A free 20-minute diagnostic call. Diagnose the bottleneck, decide whether a fractional CMO engagement makes sense, get a recommendation either way.",
    url: absoluteUrl("/growth-audit/"),
    serviceType: "Growth Consulting Audit",
    offers: [
      {
        name: "20-min Growth Audit",
        description: "Free diagnostic call. 20 minutes, no pitch, no deck.",
        price: "0",
        billingIncrement: "per call"
      }
    ]
  })
];

const quickChecks = [
  {
    title: "Leads are inconsistent",
    read: "A lot of new business still comes from referrals, founder outreach or one channel that behaves differently every month.",
    check: "First check: where did your last 10 real opportunities come from, and how many of those sources can you deliberately repeat?",
    href: "/case-studies/"
  },
  {
    title: "People don't really get the product",
    read: "Sales calls go better than the website, ads or outbound because someone has to explain the value properly.",
    check: "First check: compare the words customers use on calls with the words on your homepage. If they sound like two different companies, start there.",
    href: "/writing/do-customer-research-before-you-buy-more-traffic/"
  },
  {
    title: "You've tried loads of marketing",
    read: "Paid, content, outbound and partnerships are all doing something, but nobody is confident about what deserves more budget.",
    check: "First check: list every live channel and write down the one decision each channel's data should help you make. If you can't, the reporting is probably part of the problem.",
    href: "/method/"
  },
  {
    title: "Growth still depends on the founder",
    read: "The team can execute, but priorities, context and the difficult calls still come back to you.",
    check: "First check: write down the growth decisions only you made last week. Those are the decisions we need to either remove, document or hand over.",
    href: "/fractional-cmo/"
  }
];
---

<BaseLayout
  description="Book a free 20-minute growth audit. Daniel Johnson helps diagnose your bottleneck and decides with you if engaging makes sense, or what to do instead."
  keywords="free growth audit, startup bottleneck call, fractional CMO diagnostic, 20 minute GTM call"
  path="/growth-audit/"
  schema={schemas}
  stickyCta={false}
  title="Free 20-min Growth Audit | Daniel Johnson"
>
  <section class="hero-section section-space">
    <div class="shell">
      <div class="reveal mx-auto max-w-3xl space-y-6 text-center">
        <span class="service-label justify-center">Tier 1 · Free</span>
        <h1 class="text-5xl font-extrabold leading-[1.05] tracking-[-0.06em] text-balance md:text-7xl">
          Bring the messy growth question. <span class="hero-accent">Leave with a clearer next step.</span>
        </h1>
        <p class="hero-subcopy mx-auto max-w-2xl text-lg leading-8 md:text-xl">
          Bring me the messy version. In 20 minutes we'll work out what looks most likely to be holding growth back and what I would do next. If I don't think you need me, I'll say so.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a class="button-accent" href={ctas.primary.href} data-cta="growth-audit-hero-primary">
            {ctas.primary.label} →
          </a>
          <a class="button-link" href="#agenda" data-cta="growth-audit-hero-agenda">
            See what's on the agenda ↓
          </a>
        </div>
        <div class="mx-auto mt-8 max-w-2xl rounded-2xl border border-[color:var(--line)] bg-[color:var(--surface-dim)] p-6 text-left">
          <p class="card-label">After you book</p>
          <ol class="mt-4 space-y-4">
            {
              afterYouBookSteps.map((step, i) => (
                <li class="flex gap-3">
                  <span class="mono text-sm text-[color:var(--subtle)]">{String(i + 1).padStart(2, "0")}</span>
                  <div>
                    <p class="font-semibold text-[color:var(--ink)]">{step.title}</p>
                    <p class="mt-1 text-sm leading-7 text-[color:var(--muted)]">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space pt-0" aria-labelledby="quick-check-heading">
    <div class="shell">
      <SectionHeader
        eyebrow="Before you book"
        title="Which of these sounds closest?"
        intro="You don't need to diagnose yourself. This is just a quick way to see what I would look at first."
      />
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {quickChecks.map((item) => (
          <article class="card p-6 md:p-7">
            <h2 class="text-xl font-bold tracking-[-0.04em]">{item.title}</h2>
            <p class="mt-3 text-base leading-7 text-[color:var(--muted)]">{item.read}</p>
            <p class="mt-4 text-sm leading-7"><strong>{item.check}</strong></p>
            <a class="link-arrow mt-5" href={item.href}>Read something useful first</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space pt-0" aria-labelledby="sample-output-heading">
    <div class="shell">
      <div class="reveal mx-auto max-w-3xl card p-8 md:p-10">
        <p class="card-label">Sample output</p>
        <h2 id="sample-output-heading" class="mt-3 text-2xl font-extrabold tracking-[-0.05em] md:text-3xl">
          {growthAuditSampleOutput.leadIn}
        </h2>
        <blockquote class="mt-6 border-l-4 border-[color:var(--accent)] pl-6 text-base leading-8 text-[color:var(--muted)]">
          &ldquo;{growthAuditSampleOutput.quote}&rdquo;
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section-space pt-0" id="agenda" aria-labelledby="agenda-heading">
    <div class="shell">
      <SectionHeader
        eyebrow="What's on the agenda"
        title="20 minutes, four things."
        intro="No prep deck on your end. The questions are designed to fit the time."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {growthAuditPage.agenda.map((item, index) => (
          <article class="card p-6">
            <p class="card-label">0{index + 1}</p>
            <h2 class="mt-3 text-xl font-extrabold tracking-[-0.04em]">{item.title}</h2>
            <p class="mt-3 text-base leading-7 text-[color:var(--muted)]">{item.body}</p>
          </article>
        ))}
      </div>
      <p class="reveal mx-auto mt-6 max-w-3xl text-center text-sm leading-7 text-[color:var(--muted)]">
        If you are still deciding whether the issue is traffic, offer, or positioning, read
        <a class="font-semibold text-[color:var(--ink)] underline underline-offset-4 hover:text-[color:var(--accent)]" href="/writing/do-customer-research-before-you-buy-more-traffic/">Do customer research before you buy more traffic</a>
        before adding more spend.
      </p>
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="shell grid gap-6 md:grid-cols-2">
      <article class="card p-6 md:p-8">
        <p class="card-label text-[color:var(--accent)]">Helpful to bring</p>
        <ul class="mt-4 space-y-3 text-base leading-8">
          {growthAuditPage.bring.map((item) => <li class="fit-row fit-row-yes">{item}</li>)}
        </ul>
      </article>
      <article class="card p-6 md:p-8">
        <p class="card-label">Probably not the right call if…</p>
        <ul class="mt-4 space-y-3 text-base leading-8 text-[color:var(--muted)]">
          {growthAuditPage.notForYou.map((item) => <li class="fit-row fit-row-no">{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="dark-section section-space">
    <div class="shell">
      <div class="reveal mx-auto max-w-3xl text-center">
        <span class="eyebrow justify-center text-white/60">What you walk away with</span>
        <h2 class="mt-4 text-4xl font-extrabold leading-[1.05] tracking-[-0.06em] text-white md:text-5xl">
          A clearer idea of what's going wrong and what to do next.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/72">
          If working together makes sense, we'll talk about engagement shape: Strategy Sprint or Fractional CMO. If it doesn't, you'll get the right operator, agency, or mentor to go to instead. Either way, you leave with a sharper plan than you came in with.
        </p>
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="audit-faq-heading">
    <div class="shell">
      <SectionHeader
        eyebrow="FAQ"
        title="Three questions founders ask first."
      />
      <div class="faq-stack mt-8 mx-auto max-w-3xl">
        {growthAuditPage.faq.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-gradient section-space">
    <div class="shell">
      <div class="reveal mx-auto max-w-3xl space-y-6 text-center">
        <span class="eyebrow justify-center text-white/60">Next step</span>
        <h2 class="text-5xl font-extrabold leading-[1.02] tracking-[-0.07em] text-balance text-white md:text-6xl">
          Book the 20-min Growth Audit.
        </h2>
        <p class="mx-auto max-w-2xl text-lg leading-8 text-white/72">
          20 minutes. No pitch. You'll leave with a clearer read on your biggest growth bottleneck and whether working together makes sense.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a class="button-accent" href={ctas.primary.href} data-cta="growth-audit-final-primary">
            {ctas.primary.label} →
          </a>
          <a class="button-link-invert" href="/start-here/" data-cta="growth-audit-final-start-here">
            Not ready? Read /start-here →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
