---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Your Founder-Led Growth Operating System | Daniel Johnson"
  description="Download the editable Founder-Led Growth Operating System workbook and companion guide."
  path="/founder-led-growth-operating-system/thanks/"
  metaRobots="noindex,follow"
  lastUpdated={false}
  stickyCta={false}
>
  <section class="section-space">
    <div class="shell">
      <div class="reveal mx-auto max-w-5xl">
        <span class="service-label">System unlocked</span>
        <h1 class="mt-5 text-5xl font-extrabold leading-[1.02] tracking-[-0.07em] text-balance md:text-7xl">
          Your founder-led growth operating system is ready.
        </h1>
        <p class="hero-subcopy mt-6 max-w-3xl text-xl leading-9">
          Start with the workbook, then keep the short guide beside you while you map the first ten recurring growth decisions.
          The first email contains the same links for later.
        </p>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          <article class="card p-6 md:p-8">
            <p class="card-label">Editable workbook</p>
            <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em]">Founder-Led Growth Operating System</h2>
            <p class="mt-4 text-base leading-8 text-[color:var(--muted)]">
              Six working sheets for ownership, weekly rhythm, decisions, dependency, and staged handoffs.
            </p>
            <a
              class="button-accent mt-6"
              href="/downloads/founder-led-growth-operating-system.xlsx"
              download
              data-download="founder-led-growth-operating-system-xlsx"
            >
              Download the Excel workbook →
            </a>
          </article>
          <article class="card p-6 md:p-8">
            <p class="card-label">Companion guide</p>
            <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em]">Founder Operating Playbook</h2>
            <p class="mt-4 text-base leading-8 text-[color:var(--muted)]">
              Three practical pages on decision ownership, weekly cadence, shadowing, and the four-week installation sequence.
            </p>
            <a
              class="button-secondary mt-6"
              href="/downloads/founder-led-growth-operating-system-guide.pdf"
              download
              data-download="founder-led-growth-operating-system-pdf"
            >
              Download the PDF guide →
            </a>
          </article>
        </div>
        <div class="card-muted mt-6 p-6 md:p-8">
          <p class="card-label">A useful first move</p>
          <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em]">Run the dependency check before the next weekly growth meeting.</h2>
          <p class="mt-4 max-w-3xl text-base leading-8 text-[color:var(--muted)]">
            Pick the highest-scoring statement and hand off one recurring decision layer through a shadow week and a reverse-shadow week.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
